---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrowseProducts from '../../components/BrowseProducts.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

const [all, reviews] = await Promise.all([
  getCollection('cpap-bipap'),
  getCollection('cpap-bipap-reviews'),
]);
const scoreMap: Record<string, number> = {};
for (const r of reviews) {
  if (typeof r.data.score === 'number') scoreMap[r.id] = r.data.score;
}

const cpapProducts = all
  .filter((entry) => entry.data.device_type === 'cpap')
  .sort((a, b) => {
    const sa = scoreMap[a.data.slug] ?? 0;
    const sb = scoreMap[b.data.slug] ?? 0;
    if (sb !== sa) return sb - sa;
    return a.data.product_name.localeCompare(b.data.product_name, 'en');
  });

const pageTitle = 'CPAP machines';
const description =
  'Every CPAP machine sold in India — auto, fixed-pressure, and travel units — scored against the same published rubric. Search and filter by brand and price.';

const crumbs = [
  { href: '/', label: 'Home' },
  { href: '/cpap/', label: 'CPAP' },
];
---
<BaseLayout title={pageTitle} description={description}>
  <Breadcrumbs items={crumbs} />

  <header class="hub-header">
    <h1>{pageTitle}</h1>
    <p class="lead">
      {cpapProducts.length} CPAP machines available in India — auto-titrating, fixed-pressure, and travel-friendly models. Every device is scored against the same published rubric.
    </p>
  </header>

  <section aria-labelledby="cpap-explained">
    <h2 id="cpap-explained">What is a CPAP machine?</h2>
    <p>CPAP delivers pressurised air through a mask to help keep the airway open during sleep. Fixed CPAP provides a set pressure; auto-adjusting CPAP (APAP) varies pressure within a configured range. A bilevel device uses different pressures for inhalation and exhalation. The prescribed mode guides the choice. <a href="https://www.nhlbi.nih.gov/health/cpap">NHLBI explains how CPAP works.</a></p>
    <h2>Choosing a machine and mask in India</h2>
    <p>Compare prescribed mode, humidification, data access, compatible masks, local service and the total cost of replacement supplies. A nasal mask covers the nose; nasal pillows sit at the nostrils; a full-face mask covers the nose and mouth. Fit and seal matter when choosing among them.</p>
    <p>See the <a href="/top-5/cpap-machines/">five-machine comparison</a>, <a href="/guides/cpap-vs-bipap-indications/">CPAP vs BiPAP guide</a> and <a href="/cpap/apap/">APAP explainer</a>. The <a href="/in/respiratory-care-experts/">Home Medix dealer and service network</a> identifies partners by region and describes services including setup, mask fitting, rentals, repairs and staff training. Service availability varies by partner.</p>
  </section>

  {cpapProducts.length === 0 ? (
    <p class="empty">No CPAP reviews published yet. Check back soon.</p>
  ) : (
    <BrowseProducts entries={cpapProducts} basePath="/cpap/" kind="cpap-bipap" scoreMap={scoreMap} />
  )}
</BaseLayout>

<style>
  .hub-header {
    margin-bottom: var(--space-8);
  }
  .empty {
    color: var(--color-text-muted);
  }
</style>
