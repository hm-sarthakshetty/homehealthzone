---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrowseProducts from '../../components/BrowseProducts.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

const [all, reviews] = await Promise.all([
  getCollection('cpap-bipap'),
  getCollection('cpap-bipap-reviews'),
]);
const scoreMap: Record<string, number> = {};
for (const r of reviews) {
  if (typeof r.data.score === 'number') scoreMap[r.id] = r.data.score;
}

const bipapProducts = all
  .filter((entry) => entry.data.device_type === 'bipap')
  .sort((a, b) => {
    const sa = scoreMap[a.data.slug] ?? 0;
    const sb = scoreMap[b.data.slug] ?? 0;
    if (sb !== sa) return sb - sa;
    return a.data.product_name.localeCompare(b.data.product_name, 'en');
  });

const pageTitle = 'BiPAP Machine Reviews and Specifications';
const description =
  'Browse BiPAP machine reviews and specifications for India across Auto, ST and VAPS modes. Compare models, prices, scores and service considerations.';

const crumbs = [
  { href: '/', label: 'Home' },
  { href: '/bipap/', label: 'BiPAP' },
];
---
<BaseLayout title={pageTitle} description={description}>
  <Breadcrumbs items={crumbs} />

  <header class="hub-header">
    <h1>{pageTitle}</h1>
    <p class="lead">
      Browse {bipapProducts.length} BiPAP machines sold in India across S, Auto, S/T and VAPS modes. Every device is scored against the same published rubric.
    </p>
    <nav class="hub-paths" aria-label="BiPAP buying guides">
      <a href="/top-5/bipap-machines/">Best BiPAP machines in India</a>
      <a href="/bipap/price-india/">BiPAP machine prices</a>
      <a href="/guides/cpap-vs-bipap-indications/">CPAP vs BiPAP indications</a>
    </nav>
  </header>

  {bipapProducts.length === 0 ? (
    <p class="empty">No BiPAP reviews published yet. Check back soon.</p>
  ) : (
    <BrowseProducts entries={bipapProducts} basePath="/bipap/" kind="cpap-bipap" scoreMap={scoreMap} />
  )}
</BaseLayout>

<style>
  .hub-header {
    margin-bottom: var(--space-8);
  }
  .empty {
    color: var(--color-text-muted);
  }
  .hub-paths {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-5);
  }
</style>
