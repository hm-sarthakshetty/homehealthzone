    ],
  },
  {
    title: 'CPAP masks and supplies',
    links: [
      ['Best CPAP masks', 'best-cpap-masks'],
      ['CPAP supplies replacement schedule', 'cpap-supplies-replacement-schedule'],
    ],
  },
];
const featuredClusters = clusterDefs
  .map((c) => ({
    title: c.title,
    links: c.links
      .filter(([, id]) => ids.has(id))
      .map(([label, id]) => [label, `/us/guides/${id}/`] as [string, string]),
  }))
  .filter((c) => c.links.length > 0);
---

<BaseLayout title={pageTitle} description={description} lang="en-US">
  <Breadcrumbs items={crumbs} />
  <header class="hub-header">
    <h1>{pageTitle}</h1>
    <p class="lead">
      Plain-English guides to buying and paying for respiratory equipment in the United States —
      prescriptions, Medicare rules, air travel, and which devices are actually on sale. Prices are in
      US dollars and every guide is reviewed and timestamped.
    </p>
  </header>

  <section class="featured-guides" aria-labelledby="featured-guides-heading">
    <h2 id="featured-guides-heading">Guide clusters</h2>
    <div class="featured-guides__grid">
      {featuredClusters.map((cluster) => (
        <article class="featured-guides__cluster">
          <h3>{cluster.title}</h3>
          <ul>
            {cluster.links.map(([label, href]) => (
              <li><a href={href}>{label}</a></li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  {sorted.length === 0 ? (
    <p class="empty">No guides published yet.</p>
  ) : (
    <div class="article-grid">
      {sorted.map((entry) => (
        <ArticleCard entry={entry} href={`/us/guides/${entry.id}/`} />
      ))}
    </div>
  )}
</BaseLayout>

<style>
  .hub-header {
    margin-bottom: var(--space-8);
  }
  .featured-guides {
    margin-bottom: var(--space-8);
  }
  .featured-guides h2 {
    margin-bottom: var(--space-4);
  }
  .featured-guides__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-4);
  }
  .featured-guides__cluster {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-4);
    background: var(--color-surface);
  }
  .featured-guides__cluster h3 {
    margin-top: 0;
    font-size: var(--text-lg);
  }
  .featured-guides__cluster ul {
    margin-bottom: 0;
    padding-left: var(--space-5);
  }
  .article-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-5);
  }
  .empty {
    color: var(--color-text-muted);
  }
</style>
