---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

const guides = await getCollection('us-guides');

// Sort by lastReviewed desc when present, then by title (mirrors /guides/).
const sorted = guides.slice().sort((a, b) => {
  const aDate = a.data.lastReviewed ?? '';
  const bDate = b.data.lastReviewed ?? '';
  if (aDate && bDate && aDate !== bDate) return bDate.localeCompare(aDate);
  return a.data.title.localeCompare(b.data.title, 'en');
});

const pageTitle = "US buyer's guides";
const description =
  'Buying guides for US patients: home and portable oxygen concentrators, CPAP machines and masks, troubleshooting, supplies, costs, HSA/FSA, Medicare coverage, FAA rules for flying with oxygen, and the Philips recall.';

const crumbs = [
  { href: '/', label: 'Home' },
  { href: '/us/', label: 'United States' },
  { href: '/us/guides/', label: 'Guides' },
];

// Only link guides that exist, so a cluster never points at a 404.
const ids = new Set(guides.map((g) => g.id));
const clusterDefs: Array<{ title: string; links: Array<[string, string]> }> = [
  {
    title: 'Buying oxygen equipment',
    links: [
      ['Best home oxygen concentrator', 'oxygen-concentrator-buyers-guide'],
      ['Best portable oxygen concentrator', 'best-portable-oxygen-concentrator'],
      ['5 LPM vs 10 LPM oxygen concentrator', '5-lpm-vs-10-lpm'],
      ['Flying with a portable oxygen concentrator', 'faa-portable-oxygen-concentrator-rules'],
    ],
  },
  {
    title: 'Portable oxygen',
    links: [
      ['Portable oxygen battery life by model', 'portable-oxygen-concentrator-battery-life'],
      ['Pulse dose vs continuous flow', 'pulse-dose-vs-continuous-flow'],
      ['Sleeping with a portable oxygen concentrator', 'portable-oxygen-concentrator-for-sleeping'],
      ['Inogen Rove 6 vs CAIRE FreeStyle Comfort', 'inogen-rove-6-vs-caire-freestyle-comfort'],
      ['OxyGo NEXT review', 'oxygo-next-review'],
      ['Buying a used or refurbished concentrator', 'used-refurbished-oxygen-concentrator'],
      ['Renting a portable concentrator for travel', 'rent-portable-oxygen-concentrator-travel'],
    ],
  },
  {
    title: 'COPD and home oxygen',
    links: [
      ['Oxygen saturation targets for COPD', 'oxygen-saturation-targets-copd'],
      ['Home oxygen fire safety', 'home-oxygen-fire-safety'],
      ['Oxygen concentrator electricity cost', 'oxygen-concentrator-electricity-cost'],
      ['Oxygen at altitude: Denver and the mountains', 'oxygen-at-altitude-denver'],
      ['Cruising with oxygen', 'cruising-with-oxygen'],
      ['Oxygen cylinders vs concentrators', 'oxygen-cylinders-vs-concentrators'],
      ['Switching your Medicare oxygen supplier', 'switch-medicare-oxygen-supplier'],
    ],
  },
  {
    title: 'Medicare coverage',
    links: [
      ['Medicare home oxygen coverage', 'medicare-oxygen-coverage'],
      ['Medicare CPAP coverage and the 90-day compliance rule', 'medicare-cpap-coverage-compliance'],
      ['Using an HSA or FSA for CPAP and oxygen', 'hsa-fsa-cpap-oxygen-eligibility'],
    ],
  },
  {
    title: 'CPAP',
    links: [
      ['Best auto CPAP machine', 'cpap-buyers-guide'],
      ['Philips DreamStation alternatives', 'philips-dreamstation-cpap-alternatives'],
      ['Best travel CPAP machines', 'best-travel-cpap-machines'],
      ['CPAP cost without insurance', 'cpap-without-insurance-cost'],
      ['Philips CPAP recall and consent decree', 'philips-cpap-recall-consent-decree'],
    ],
  },
  {
    title: 'CPAP troubleshooting',
    links: [
      ['CPAP dry mouth', 'cpap-dry-mouth'],
      ['CPAP mask leaks', 'cpap-mask-leak'],
      ['High AHI on CPAP', 'high-ahi-on-cpap'],
      ['Stuffy nose on CPAP', 'cpap-nasal-congestion'],
      ['CPAP rainout', 'cpap-rainout'],
      ['Swallowing air (aerophagia)', 'cpap-aerophagia'],
      ['How to clean a CPAP', 'how-to-clean-cpap'],
      ['Chin strap vs mouth taping', 'cpap-chin-strap-mouth-taping'],
    ],
  },
  {
    title: 'CPAP machines and settings',
    links: [
      ['AirSense 11 vs AirSense 10', 'airsense-11-vs-airsense-10'],
      ['AirSense 11 settings explained', 'airsense-11-settings'],
      ['APAP vs CPAP vs BiPAP', 'apap-vs-cpap-vs-bipap'],
      ['BiPAP and ASV: Medicare rules', 'bipap-asv-medicare-coverage'],
      ['CPAP batteries and camping power', 'cpap-battery-camping-power'],
      ['Using CPAP with oxygen', 'cpap-with-oxygen'],
      ['myAir vs OSCAR: your CPAP data', 'myair-vs-oscar-cpap-data'],
    ],
  },
  {
    title: 'CPAP masks and supplies',
    links: [
      ['Best CPAP masks', 'best-cpap-masks'],
      ['CPAP supplies replacement schedule', 'cpap-supplies-replacement-schedule'],
    ],
  },
];
const featuredClusters = clusterDefs
  .map((c) => ({
    title: c.title,
    links: c.links
      .filter(([, id]) => ids.has(id))
      .map(([label, id]) => [label, `/us/guides/${id}/`] as [string, string]),
  }))
  .filter((c) => c.links.length > 0);
---

<BaseLayout title={pageTitle} description={description} lang="en-US">
  <Breadcrumbs items={crumbs} />
  <header class="hub-header">
    <h1>{pageTitle}</h1>
    <p class="lead">
      Plain-English guides to buying and paying for respiratory equipment in the United States —
      prescriptions, Medicare rules, air travel, and which devices are actually on sale. Prices are in
      US dollars and every guide is reviewed and timestamped.
    </p>
  </header>

  <section class="featured-guides" aria-labelledby="featured-guides-heading">
    <h2 id="featured-guides-heading">Guide clusters</h2>
    <div class="featured-guides__grid">
      {featuredClusters.map((cluster) => (
        <article class="featured-guides__cluster">
          <h3>{cluster.title}</h3>
          <ul>
            {cluster.links.map(([label, href]) => (
              <li><a href={href}>{label}</a></li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  {sorted.length === 0 ? (
    <p class="empty">No guides published yet.</p>
  ) : (
    <div class="article-grid">
      {sorted.map((entry) => (
        <ArticleCard entry={entry} href={`/us/guides/${entry.id}/`} />
      ))}
    </div>
  )}
</BaseLayout>

<style>
  .hub-header {
    margin-bottom: var(--space-8);
  }
  .featured-guides {
    margin-bottom: var(--space-8);
  }
  .featured-guides h2 {
    margin-bottom: var(--space-4);
  }
  .featured-guides__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-4);
  }
  .featured-guides__cluster {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-4);
    background: var(--color-surface);
  }
  .featured-guides__cluster h3 {
    margin-top: 0;
    font-size: var(--text-lg);
  }
  .featured-guides__cluster ul {
    margin-bottom: 0;
    padding-left: var(--space-5);
  }
  .article-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-5);
  }
  .empty {
    color: var(--color-text-muted);
  }
</style>
