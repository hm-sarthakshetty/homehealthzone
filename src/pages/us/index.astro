---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import SearchBox from '../../components/SearchBox.astro';
import { getCollection } from 'astro:content';

const guides = (await getCollection('us-guides')).sort((a, b) => a.data.title.localeCompare(b.data.title, 'en'));
const crumbs = [{ href: '/', label: 'Home' }, { href: '/us/', label: 'United States' }];
---
<BaseLayout title="United States Respiratory Equipment Buying Guides" description="US buying guides to oxygen concentrators, CPAP and masks, with local prices, prescription rules, Medicare coverage and equipment advice." lang="en-US">
  <Breadcrumbs items={crumbs} />
  <header class="wayfinding-hero">
    <p class="section-kicker">Country buying guides · United States</p>
    <h1>Respiratory equipment guides for the United States</h1>
    <p class="lead">Find guidance on oxygen concentrators, CPAP and masks, US prescription rules and Medicare coverage. Guides include US dollar price examples from retailer listings, with the date checked.</p>
  </header>

  <section class="wayfinding-section" aria-labelledby="hub-search-heading">
    <h2 id="hub-search-heading" class="section-kicker">Search US buying guides</h2>
    <SearchBox src="/search-index.json" market="us" resultType="guide" label="Search United States guides" id="hub-search" placeholder="Try Medicare, portable oxygen, CPAP masks…" minChars={2} maxResults={8} />
  </section>

  <section class="wayfinding-section" aria-labelledby="us-guides-heading">
    <h2 id="us-guides-heading">US buying guides</h2>
    <p><a href="/us/guides/">Browse all {guides.length} US guides by topic →</a></p>
    <div class="grid-2">{guides.map((g) => <ArticleCard entry={g} />)}</div>
  </section>

  <p class="wayfinding-note">Looking for individual device reviews? The <a href="/in/">product directory covers India</a>. For other local advice, <a href="/#country-guides">choose a country</a>, or explore the <a href="/clinical/">clinical reference library</a>.</p>
</BaseLayout>
