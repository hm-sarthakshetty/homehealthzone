---
import BaseLayout from '../layouts/BaseLayout.astro';
import SchemaOrganization from '../components/SchemaOrganization.astro';
import SchemaWebSite from '../components/SchemaWebSite.astro';
import SearchBox from '../components/SearchBox.astro';
import { getCollection } from 'astro:content';
import { LIVE_MARKETS } from '../data/markets';

const [products, pap, guides, usGuides, intlGuides, clinical] = await Promise.all([
  getCollection('products'), getCollection('cpap-bipap'), getCollection('guides'),
  getCollection('us-guides'), getCollection('intl-guides'), getCollection('clinical'),
]);
const deviceCount = products.length + pap.length;
const countries = [
  { href: '/guides/', name: 'India', code: 'IN', note: 'Rupee prices, equipment selection and home use', count: guides.length },
  { href: '/us/guides/', name: 'United States', code: 'US', note: 'Prescriptions, Medicare and US buying advice', count: usGuides.length },
  ...LIVE_MARKETS.map((m) => ({
    href: `/${m.code}/guides/`, name: m.label, code: m.country,
    note: `${m.currency} prices, local funding and equipment guidance`,
    count: intlGuides.filter((g) => g.id.startsWith(`${m.code}/`)).length,
  })),
];
---
<BaseLayout title="Respiratory Equipment Reviews and Country Guides" description="Browse the India product directory, respiratory equipment buying guides for seven countries, and the HHZ clinical reference library.">
  <header class="wayfinding-hero">
    <p class="section-kicker">HHZ Respiratory Review</p>
    <h1>Respiratory equipment reviews and guides</h1>
    <p class="lead">Explore our India product directory, choose buying guides for your country, or read the clinical reference library.</p>
  </header>

  <section class="wayfinding-section" aria-labelledby="search-heading">
    <h2 id="search-heading" class="section-kicker">Search HHZ</h2>
    <SearchBox src="/search-index.json" market="all" id="global-search" label="Search India devices, country guides and clinical articles" placeholder="Try a device, topic or country — e.g. AirSense, Medicare, oxygen…" minChars={2} maxResults={10} />
    <p class="wayfinding-note">Product reviews cover India. Buying guides cover all seven countries; each result shows its country and content type.</p>
  </section>

  <section class="wayfinding-section" aria-labelledby="directory-heading">
    <h2 id="directory-heading">India product directory</h2>
    <p>Compare {deviceCount} oxygen concentrators, CPAP and BiPAP devices in the India catalogue, with published specifications, rupee prices and review scores.</p>
    <p><a class="wayfinding-link" href="/in/">Open the India product directory →</a></p>
    <nav class="wayfinding-inline" aria-label="India product categories">
      <a href="/oxygen-concentrators/">Oxygen concentrators</a>
      <a href="/cpap/">CPAP</a>
      <a href="/bipap/">BiPAP</a>
      <a href="/compare/">Compare devices</a>
    </nav>
  </section>

  <section class="wayfinding-section" aria-labelledby="partners-heading">
    <h2 id="partners-heading">Respiratory equipment manufacturers and local support</h2>
    <p>Find named Home Medix dealer and service partners in Tamil Nadu, Andhra Pradesh, Telangana, Pune and Kerala, with business locations, public references and equipment services.</p>
    <nav class="wayfinding-inline" aria-label="Manufacturers and service partners">
      <a href="/in/respiratory-care-experts/">Home Medix service partner hub</a>
      <a href="/manufacturers/home-medix/">Home Medix manufacturer profile</a>
      <a href="/manufacturers/">Manufacturer reference</a>
    </nav>
  </section>

  <section id="country-guides" class="wayfinding-section" aria-labelledby="countries-heading">
    <h2 id="countries-heading">Buying guides by country</h2>
    <p>Choose your country for local equipment advice, prices, funding and rules.</p>
    <div class="wayfinding-grid">
      {countries.map((country) => (
        <a class="card" href={country.href}>
          <span class="section-kicker">{country.code} · {country.count} guides</span>
          <h3>{country.name}</h3>
          <p>{country.note}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="wayfinding-section" aria-labelledby="clinical-heading">
    <h2 id="clinical-heading">Clinical reference library</h2>
    <p>{clinical.length} articles explain respiratory conditions, oxygen therapy, sleep therapy and equipment use.</p>
    <p><a class="wayfinding-link" href="/clinical/">Browse clinical articles →</a></p>
  </section>

  <p class="wayfinding-note">Looking for comparisons, shortlists or our review policies? <a href="/site-map/">See the site map</a>.</p>
  <SchemaWebSite />
  <SchemaOrganization />
</BaseLayout>
