---
import BaseLayout from '../layouts/BaseLayout.astro';
import SchemaOrganization from '../components/SchemaOrganization.astro';
import SchemaWebSite from '../components/SchemaWebSite.astro';
import SearchBox from '../components/SearchBox.astro';
import { getCollection } from 'astro:content';
import { LIVE_MARKETS } from '../data/markets';

const [products, cpapBipap, guides, usGuides, intlGuides] = await Promise.all([
  getCollection('products'),
  getCollection('cpap-bipap'),
  getCollection('guides'),
  getCollection('us-guides'),
  getCollection('intl-guides'),
]);
const allProducts = [...products, ...cpapBipap];

const marketCards = [
  { href: '/in/', name: 'India', code: 'IN', note: `${allProducts.length} devices with rupee prices`, guides: guides.length },
  { href: '/us/', name: 'United States', code: 'US', note: 'USD prices, FDA rules and Medicare basics', guides: usGuides.length },
  ...LIVE_MARKETS.map((m) => ({
    href: `/${m.code}/`,
    name: m.label,
    code: m.country,
    note: `${m.currency} prices, local funding and regulation`,
    guides: intlGuides.filter((g) => g.id.startsWith(`${m.code}/`)).length,
  })),
];

const desc =
  'Respiratory equipment directory: oxygen concentrators, CPAP, BiPAP and masks, with specs, prices and buyer’s guides for India, the US, UK, Singapore, Australia, Canada and New Zealand.';
---
<BaseLayout title="Respiratory Equipment Directory" description={desc}>
  <section class="home-hero">
    <p class="home-hero__kicker">HHZ · {marketCards.length} markets</p>
    <h1>Respiratory Equipment Directory</h1>
    <p class="lead">
      Oxygen concentrators, CPAP, BiPAP and masks: specs, prices and guides by country.
    </p>
  </section>

  <section class="home-markets" aria-labelledby="home-markets-heading">
    <h2 id="home-markets-heading" class="section-kicker">Choose your country</h2>
    <div class="home-catalogue__grid">
      {marketCards.map((m) => (
        <a class="home-cat" href={m.href}>
          <span class="home-cat__key mono-data">{m.code}</span>
          <span class="home-cat__body">
            <span class="home-cat__title">{m.name}</span>
            <span class="home-cat__meta mono-data">{m.guides} guides</span>
            <span class="home-cat__note">{m.note}</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="home-search" aria-labelledby="home-search-heading">
    <h2 id="home-search-heading" class="section-kicker">India: search {allProducts.length} reviewed devices</h2>
    <SearchBox
      entries={allProducts}
      id="home-search"
      placeholder="Type at least 2 characters — e.g. philips, 10 lpm, airsense…"
      minChars={2}
      maxResults={8}
    />
    <p class="home-search__popular">
      The full India catalogue, top picks and guides are on the <a href="/in/">India hub</a>.
    </p>
  </section>

  <SchemaWebSite />
  <SchemaOrganization />
</BaseLayout>

<style>
  .home-hero {
    padding: var(--space-8) 0 var(--space-10);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-10);
  }

  .home-hero__kicker {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-4);
  }

  .home-hero h1 {
    font-size: clamp(2rem, 4vw + 1rem, 3.25rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin: 0 0 var(--space-4);
    max-width: 22ch;
  }

  .home-hero .lead {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 52ch;
    margin: 0;
  }

  .home-search {
    margin-bottom: var(--space-12);
  }
  .home-search__popular {
    margin-top: var(--space-4);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }
  .home-search__popular .section-kicker {
    margin-right: var(--space-2);
    margin-bottom: 0;
  }
  .home-search__popular a {
    text-decoration: none;
    border-bottom: 1px solid var(--color-border-strong);
    padding-bottom: 1px;
  }
  .home-search__popular a:hover {
    border-bottom-color: var(--color-accent);
  }
  .home-search__divider {
    color: var(--color-text-subtle);
  }

  .home-catalogue__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 0;
    border-top: 1px solid var(--color-rule);
    border-left: 1px solid var(--color-rule);
  }

  .home-cat {
    display: grid;
    grid-template-columns: 56px 1fr;
    padding: var(--space-4) var(--space-5);
    border-right: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
    text-decoration: none;
    color: var(--color-text);
    background: var(--color-bg);
    transition: background 0.12s ease;
  }
  .home-cat:hover {
    background: var(--color-surface);
    color: var(--color-text);
  }
  .home-cat__key {
    font-weight: 700;
    color: var(--color-accent);
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
    line-height: 1.2;
    align-self: center;
  }
  .home-cat__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .home-cat__title {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--text-base);
    letter-spacing: -0.01em;
  }
  .home-cat__meta {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .home-in__more { margin-top: var(--space-8); font-size: var(--text-sm); color: var(--color-text-muted); }
  .home-markets { margin-bottom: var(--space-12); }
  .home-cat__note { font-size: var(--text-sm); color: var(--color-text-muted); }
</style>
