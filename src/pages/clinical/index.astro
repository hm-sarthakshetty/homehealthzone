---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { groupClinicalArticles } from '../../lib/clinical-topics';

const articles = await getCollection('clinical');

const topics = groupClinicalArticles(articles);

const pageTitle = 'Clinical education';
const description =
  'Clinical background on respiratory therapy for Indian patients and caregivers — PSA chemistry, AHI explained, GOLD guidelines, and what the numbers on your report mean.';

const crumbs = [
  { href: '/', label: 'Home' },
  { href: '/clinical/', label: 'Clinical' },
];
---
<BaseLayout title={pageTitle} description={description}>
  <Breadcrumbs items={crumbs} />

  <header class="hub-header">
    <h1>{pageTitle}</h1>
    <p class="lead">
      Clinical background on respiratory disease and therapy — PSA chemistry, AHI thresholds,
      GOLD staging, and how to read the numbers that come with your equipment. Browse
      {articles.length} articles by topic, or start with a focused decoder below.
    </p>
  </header>

  <nav class="topic-nav" aria-labelledby="topics-heading" id="browse-topics">
    <h2 id="topics-heading">Browse by topic</h2>
    <ul>
      {topics.map((topic) => (
        <li><a href={`#${topic.id}`}><span>{topic.title}</span><span class="topic-count">{topic.articles.length} articles</span></a></li>
      ))}
    </ul>
  </nav>

  <section class="decoder-section" aria-labelledby="decoder-heading">
    <div class="section-heading">
      <p class="eyebrow">Start with the number or device in front of you</p>
      <h2 id="decoder-heading">Clinical decoders</h2>
      <p>
        Short, focused explanations for the settings, report labels and oxygen interfaces that
        most often cause confusion.
      </p>
    </div>

    <div class="decoder-grid">
      <article class="decoder-card">
        <h3>Oxygen masks and interfaces</h3>
        <ul>
          <li><a href="/clinical/venturi-mask-vs-non-rebreather-mask/">Venturi vs non-rebreather</a></li>
          <li><a href="/clinical/nasal-cannula-vs-oxygen-mask/">Nasal cannula vs oxygen mask</a></li>
          <li><a href="/clinical/simple-oxygen-mask-vs-non-rebreather/">Simple mask vs non-rebreather</a></li>
          <li><a href="/clinical/venturi-mask-colour-chart-flow-rate-fio2/">Venturi colour and FiO₂ chart</a></li>
        </ul>
      </article>

      <article class="decoder-card">
        <h3>CPAP and BiPAP numbers</h3>
        <ul>
          <li><a href="/clinical/ipap-vs-epap-vs-pressure-support/">IPAP, EPAP and pressure support</a></li>
          <li><a href="/clinical/bipap-trigger-cycle-rise-time-ti-explained/">Trigger, cycle, rise time and Ti</a></li>
          <li><a href="/clinical/cpap-report-oa-ca-h-fl-rera-explained/">OA, CA, H, FL and RERA</a></li>
          <li><a href="/clinical/cpap-95th-percentile-pressure-explained/">95th-percentile CPAP pressure</a></li>
        </ul>
      </article>
    </div>
  </section>

  {topics.map((topic) => (
    <section class="topic-section" aria-labelledby={`${topic.id}-heading`} id={topic.id}>
      <div class="topic-heading">
        <div>
          <h2 id={`${topic.id}-heading`}>{topic.title} <span class="topic-count">{topic.articles.length} articles</span></h2>
          <p>{topic.description}</p>
        </div>
        <a class="back-to-topics" href="#browse-topics">Back to topics</a>
      </div>
      <div class="article-grid">
        {topic.articles.map((entry) => (
          <ArticleCard entry={entry} href={`/clinical/${entry.id}/`} />
        ))}
      </div>
    </section>
  ))}
</BaseLayout>

<style>
  .hub-header {
    margin-bottom: var(--space-8);
  }
  .topic-nav {
    margin-bottom: var(--space-8);
  }
  .topic-nav ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }
  .topic-nav a {
    display: flex;
    height: 100%;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    font-family: var(--font-sans);
    font-weight: 600;
  }
  .topic-count {
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 400;
    white-space: nowrap;
  }
  .topic-section {
    margin-bottom: var(--space-10);
  }
  .topic-section, .topic-nav {
    scroll-margin-top: var(--space-8);
  }
  .topic-heading {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }
  .topic-heading h2 {
    margin: 0 0 var(--space-2);
  }
  .topic-heading h2 .topic-count {
    display: inline-block;
  }
  .topic-heading p {
    margin: 0;
    color: var(--color-text-muted);
  }
  .back-to-topics {
    font-family: var(--font-sans);
    font-size: 0.85rem;
  }
  .decoder-section {
    margin-bottom: var(--space-10);
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }
  .section-heading {
    max-width: 720px;
    margin-bottom: var(--space-5);
  }
  .section-heading h2 {
    margin: 0 0 var(--space-2);
  }
  .section-heading p {
    margin: 0;
    color: var(--color-text-muted);
  }
  .eyebrow {
    margin-bottom: var(--space-2) !important;
    color: var(--color-accent) !important;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .decoder-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }
  .decoder-card {
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
  }
  .decoder-card h3 {
    margin: 0 0 var(--space-3);
  }
  .decoder-card ul {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding-left: 1.1rem;
  }
  .decoder-card a {
    font-weight: 600;
  }
  .article-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: var(--space-5);
  }
  @media (max-width: 720px) {
    .decoder-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
