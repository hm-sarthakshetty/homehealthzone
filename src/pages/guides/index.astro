---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

const guides = await getCollection('guides');

// Sort by lastReviewed desc when present, then by title.
const sorted = guides.slice().sort((a, b) => {
  const aDate = a.data.lastReviewed ?? '';
  const bDate = b.data.lastReviewed ?? '';
  if (aDate && bDate && aDate !== bDate) return bDate.localeCompare(aDate);
  return a.data.title.localeCompare(b.data.title, 'en');
});

const pageTitle = "Buyer's guides";
const description =
  'Commercial buying guides for oxygen concentrators, CPAP, BiPAP, masks, humidifiers, and power backup in India — with clear recommendations and alternatives.';

const crumbs = [
  { href: '/', label: 'Home' },
  { href: '/guides/', label: 'Guides' },
];

const featuredClusters = [
  {
    title: 'Budget CPAP and BiPAP',
    links: [
      ['Best auto CPAP under ₹30,000', '/guides/best-auto-cpap-under-30000-india/'],
      ['Best BiPAP under ₹50,000', '/guides/best-bipap-under-50000-india/'],
      ['Best CPAP with humidifier under ₹30,000', '/guides/best-cpap-with-humidifier-under-30000-india/'],
    ],
  },
  {
    title: 'Replace premium PAP devices',
    links: [
      ['ResMed AirSense 11 alternatives', '/guides/resmed-airsense-11-alternatives-india/'],
      ['Philips DreamStation CPAP alternatives', '/guides/philips-dreamstation-cpap-alternatives-india/'],
      ['Philips DreamStation BiPAP and AVAPS alternatives', '/guides/philips-dreamstation-bipap-avaps-alternatives-india/'],
    ],
  },
  {
    title: 'Home Medix CPAP comparisons',
    links: [
      ['HM-CV-20 vs ResMed AirSense 10', '/guides/home-medix-hm-cv-20-vs-resmed-airsense-10-india/'],
      ['HM-CV-20 vs ResMed AirSense 11', '/guides/home-medix-hm-cv-20-vs-resmed-airsense-11-india/'],
      ['HM-CV-20 vs BMC GII Auto CPAP', '/guides/home-medix-hm-cv-20-vs-bmc-gii-auto-cpap-india/'],
    ],
  },
  {
    title: 'Home Medix BiPAP comparisons',
    links: [
      ['HM-BV-30 vs ResMed Lumis 150', '/guides/home-medix-hm-bv-30-vs-resmed-lumis-150-india/'],
      ['HM-BV-30 vs DreamStation AVAPS', '/guides/home-medix-hm-bv-30-vs-philips-dreamstation-bipap-avaps-india/'],
      ['HM-BV-30 vs Oxymed AirSmart VAPS', '/guides/home-medix-hm-bv-30-vs-oxymed-airsmart-vaps-india/'],
    ],
  },
  {
    title: 'CPAP masks and starter costs',
    links: [
      ['Best CPAP masks in India', '/guides/best-cpap-masks-india/'],
      ['CPAP mask price and replacement cost', '/guides/cpap-mask-price-replacement-cost-india/'],
      ['Complete CPAP starter-kit cost', '/guides/cpap-starter-kit-cost-india/'],
    ],
  },
  {
    title: 'CPAP comfort and continuity',
    links: [
      ['Best mask for mouth breathers', '/guides/best-cpap-mask-mouth-breathers-india/'],
      ['Best mask for side sleepers', '/guides/best-cpap-mask-side-sleepers-india/'],
      ['Best UPS and battery backup for CPAP', '/guides/best-ups-battery-backup-cpap-india/'],
    ],
  },
  {
    title: 'Home oxygen purchase decisions',
    links: [
      ['Best concentrator for 24/7 home use', '/guides/best-oxygen-concentrator-24-7-home-use-india/'],
      ['Best 10 LPM concentrators under ₹70,000', '/guides/best-10-lpm-oxygen-concentrators-under-70000-india/'],
      ['Philips Millennium M10 alternatives', '/guides/philips-millennium-m10-alternatives-india/'],
    ],
  },
  {
    title: 'EverFlo replacement and stock risk',
    links: [
      ['Philips EverFlo replacement in India', '/guides/philips-everflo-replacement-india/'],
      ['Should you buy Philips EverFlo now?', '/guides/should-you-buy-philips-everflo-india/'],
      ['How to check new vs refurbished stock', '/guides/how-to-check-new-vs-refurbished-oxygen-concentrator/'],
    ],
  },
];
---
<BaseLayout title={pageTitle} description={description}>
  <Breadcrumbs items={crumbs} />

  <header class="hub-header">
    <h1>{pageTitle}</h1>
    <p class="lead">
      Plain-English guides to buying respiratory equipment in India — how to read a spec sheet,
      which features matter, which are marketing fluff, and how to avoid the most common
      mistakes. Reviewed periodically and timestamped.
    </p>
  </header>

  <section class="featured-guides" aria-labelledby="featured-guides-heading">
    <h2 id="featured-guides-heading">High-intent guide clusters</h2>
    <div class="featured-guides__grid">
      {featuredClusters.map((cluster) => (
        <article class="featured-guides__cluster">
          <h3>{cluster.title}</h3>
          <ul>
            {cluster.links.map(([label, href]) => (
              <li><a href={href}>{label}</a></li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  {sorted.length === 0 ? (
    <p class="empty">No guides published yet.</p>
  ) : (
    <div class="article-grid">
      {sorted.map((entry) => (
        <ArticleCard entry={entry} href={`/guides/${entry.id}/`} />
      ))}
    </div>
  )}
</BaseLayout>

<style>
  .hub-header {
    margin-bottom: var(--space-8);
  }
  .featured-guides {
    margin-bottom: var(--space-8);
  }
  .featured-guides h2 {
    margin-bottom: var(--space-4);
  }
  .featured-guides__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-4);
  }
  .featured-guides__cluster {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-4);
    background: var(--color-surface);
  }
  .featured-guides__cluster h3 {
    margin-top: 0;
    font-size: var(--text-lg);
  }
  .featured-guides__cluster ul {
    margin-bottom: 0;
    padding-left: var(--space-5);
  }
  .article-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-5);
  }
  .empty {
    color: var(--color-text-muted);
  }
</style>
