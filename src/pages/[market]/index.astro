---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import SearchBox from '../../components/SearchBox.astro';
import { getCollection } from 'astro:content';
import { LIVE_MARKETS, type Market } from '../../data/markets';

export const getStaticPaths = (() =>
  LIVE_MARKETS.map((market) => ({ params: { market: market.code }, props: { market } }))) satisfies GetStaticPaths;
interface Props { market: Market; }
const { market } = Astro.props;
const marketGuides = (await getCollection('intl-guides'))
  .filter((g) => g.id.startsWith(`${market.code}/`))
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'en'));
const hrefFor = (id: string) => `/${market.code}/guides/${id.split('/').slice(1).join('/')}/`;
const crumbs = [{ href: '/', label: 'Home' }, { href: `/${market.code}/`, label: market.label }];
---
<BaseLayout title={market.hubTitle} description={market.hubDescription} lang={market.lang}>
  <Breadcrumbs items={crumbs} />
  <header class="wayfinding-hero">
    <p class="section-kicker">Country buying guides · {market.label}</p>
    <h1>{market.hubTitle}</h1>
    <p class="lead">{market.hubLead}</p>
  </header>

  <section class="wayfinding-section" aria-labelledby="hub-search-heading">
    <h2 id="hub-search-heading" class="section-kicker">Search {market.short} buying guides</h2>
    <SearchBox src="/search-index.json" market={market.code} resultType="guide" label={`Search ${market.label} guides`} id="hub-search" placeholder="Try CPAP, home oxygen, funding or travel…" minChars={2} maxResults={8} />
  </section>

  <section class="wayfinding-section" aria-labelledby="mk-guides-heading">
    <h2 id="mk-guides-heading">{market.guidesTitle}</h2>
    <p><a href={`/${market.code}/guides/`}>Browse all {marketGuides.length} {market.short} guides by topic →</a></p>
    <div class="grid-2">{marketGuides.map((g) => <ArticleCard entry={g} href={hrefFor(g.id)} />)}</div>
  </section>

  <p class="wayfinding-note">Looking for individual device reviews? The <a href="/in/">product directory covers India</a>. For other local advice, <a href="/#country-guides">choose a country</a>, or explore the <a href="/clinical/">clinical reference library</a>.</p>
</BaseLayout>
