---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import { getCollection, render } from 'astro:content';
import { LIVE_MARKETS, type Market } from '../../../data/markets';

export const getStaticPaths = (async () => {
  const guides = await getCollection('intl-guides');
  return guides.flatMap((entry) => {
    const [code, ...rest] = entry.id.split('/');
    const market = LIVE_MARKETS.find((m) => m.code === code);
    if (!market || rest.length === 0) return [];
    return [{ params: { market: code, slug: rest.join('/') }, props: { entry, market } }];
  });
}) satisfies GetStaticPaths;

interface Props {
  entry: CollectionEntry<'intl-guides'>;
  market: Market;
}

const { entry, market } = Astro.props;
const { data } = entry;
const { Content, headings } = await render(entry);

function clampDescription(d: string): string {
  const raw = d.replace(/\s+/g, ' ').trim();
  if (raw.length <= 160) return raw;
  const truncated = raw.slice(0, 157);
  const lastSpace = truncated.lastIndexOf(' ');
  return `${truncated.slice(0, lastSpace > 120 ? lastSpace : 157)}…`;
}

const slug = entry.id.split('/').slice(1).join('/');
const canonicalURL = new URL(`/${market.code}/guides/${slug}/`, Astro.site).toString();
---
<ArticleLayout
  entry={entry}
  section="guides"
  sectionLabel={`${market.short} guides`}
  title={data.title}
  description={clampDescription(data.description)}
  canonicalURL={canonicalURL}
  headings={headings}
  market={market.code}
>
  <Content />
</ArticleLayout>
