---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { LIVE_MARKETS, type Market } from '../../../data/markets';

export const getStaticPaths = (() =>
  LIVE_MARKETS.map((market) => ({ params: { market: market.code }, props: { market } }))) satisfies GetStaticPaths;

interface Props {
  market: Market;
}
const { market } = Astro.props;

const guides = (await getCollection('intl-guides')).filter((g) => g.id.startsWith(`${market.code}/`));
const hrefFor = (id: string) => `/${market.code}/guides/${id.split('/').slice(1).join('/')}/`;

const sorted = guides.slice().sort((a, b) => {
  const aDate = a.data.lastReviewed ?? '';
  const bDate = b.data.lastReviewed ?? '';
  if (aDate && bDate && aDate !== bDate) return bDate.localeCompare(aDate);
  return a.data.title.localeCompare(b.data.title, 'en');
});

// Clusters follow the market's declared order; anything else goes last.
const names = [...new Set(guides.map((g) => g.data.cluster))].sort((a, b) => {
  const ia = market.clusters.indexOf(a);
  const ib = market.clusters.indexOf(b);
  return (ia === -1 ? 999 : ia) - (ib === -1 ? 999 : ib) || a.localeCompare(b, 'en');
});
const clusters = names.map((name) => ({
  title: name,
  links: guides
    .filter((g) => g.data.cluster === name)
    .sort((a, b) => a.data.title.localeCompare(b.data.title, 'en'))
    .map((g) => [g.data.title, hrefFor(g.id)] as [string, string]),
}));

const crumbs = [
  { href: '/', label: 'Home' },
  { href: `/${market.code}/`, label: market.label },
  { href: `/${market.code}/guides/`, label: 'Guides' },
];
---

<BaseLayout title={market.guidesTitle} description={market.guidesDescription} lang={market.lang}>
  <Breadcrumbs items={crumbs} />
  <header class="hub-header">
    <h1>{market.guidesTitle}</h1>
    <p class="lead">{market.guidesLead}</p>
  </header>

  <section class="featured-guides" aria-labelledby="featured-guides-heading">
    <h2 id="featured-guides-heading">Guide clusters</h2>
    <div class="featured-guides__grid">
      {clusters.map((cluster) => (
        <article class="featured-guides__cluster">
          <h3>{cluster.title}</h3>
          <ul>
            {cluster.links.map(([label, href]) => (
              <li><a href={href}>{label}</a></li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <div class="article-grid">
    {sorted.map((entry) => <ArticleCard entry={entry} href={hrefFor(entry.id)} />)}
  </div>
</BaseLayout>

<style>
  .hub-header { margin-bottom: var(--space-8); }
  .featured-guides { margin-bottom: var(--space-8); }
  .featured-guides h2 { margin-bottom: var(--space-4); }
  .featured-guides__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-4);
  }
  .featured-guides__cluster {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-4);
    background: var(--color-surface);
  }
  .featured-guides__cluster h3 { margin-top: 0; font-size: var(--text-lg); }
  .featured-guides__cluster ul { margin-bottom: 0; padding-left: var(--space-5); }
  .article-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-5);
  }
</style>
