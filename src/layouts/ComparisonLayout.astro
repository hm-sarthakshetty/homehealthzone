---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PriceBadge from '../components/PriceBadge.astro';
import PriceDisclaimer from '../components/PriceDisclaimer.astro';
import { formatPrice, resolvePrice } from '../lib/price';
import ComparisonTable from '../components/ComparisonTable.astro';
import ProductImage from '../components/ProductImage.astro';
import { getCollection, getEntry } from 'astro:content';

type ProductEntry = CollectionEntry<'products'> | CollectionEntry<'cpap-bipap'>;

export interface Props {
  productA: ProductEntry['data'];
  productB: ProductEntry['data'];
  productAHref?: string;
  productBHref?: string;
  productACollection?: 'products' | 'cpap-bipap';
  productBCollection?: 'products' | 'cpap-bipap';
  productAScore?: number;
  productBScore?: number;
  title?: string;
  description?: string;
  canonicalURL?: string;
  currentSlug?: string;
  comparison?: CollectionEntry<'comparisons'>['data'];
  writeupFrontmatter?: {
    title?: string;
    verdict?: string;
    winner?: 'A' | 'B' | 'tie';
    lastReviewed?: string;
    reviewedBy?: string;
  };
}

const {
  productA,
  productB,
  productAHref,
  productBHref,
  productACollection = 'products',
  productBCollection = 'products',
  productAScore,
  productBScore,
  title: titleProp,
  description: descriptionProp,
  canonicalURL,
  currentSlug,
  comparison,
  writeupFrontmatter,
} = Astro.props;

const defaultHref = (
  data: ProductEntry['data'],
  collection: 'products' | 'cpap-bipap'
): string => {
  if (collection === 'cpap-bipap') {
    const deviceType = (data as CollectionEntry<'cpap-bipap'>['data']).device_type;
    if (deviceType === 'bipap') return `/bipap/${data.slug}/`;
    return `/cpap/${data.slug}/`;
  }
  return `/oxygen-concentrators/${data.slug}/`;
};

const hrefA = productAHref ?? defaultHref(productA, productACollection);
const hrefB = productBHref ?? defaultHref(productB, productBCollection);

const compareTitle = `${productA.product_name} vs ${productB.product_name}`;
const title = titleProp ?? compareTitle;

const breadcrumbs = [
  { href: '/', label: 'Home' },
  { href: '/compare/', label: 'Compare' },
  { label: compareTitle },
];

const description =
  descriptionProp ??
  `Side-by-side comparison: ${productA.product_name} vs ${productB.product_name} — specs, price, and editorial verdict.`;

const imageA = productA.images && productA.images.length > 0 ? productA.images[0] : null;
const imageB = productB.images && productB.images.length > 0 ? productB.images[0] : null;

const effectiveSlug = comparison?.slug ?? currentSlug;

// Related comparisons and the contextual HM-KV alternative used on every
// Philips EverFlo matchup. Keeping this at layout level prevents individual
// comparison writeups from drifting or omitting the third option.
let allComparisons: CollectionEntry<'comparisons'>[] = [];
let related: CollectionEntry<'comparisons'>[] = [];
try {
  allComparisons = await getCollection('comparisons');
  related = allComparisons
    .filter((entry) => !effectiveSlug || entry.data.slug !== effectiveSlug)
    .filter((entry) => (
      entry.data.productA_slug === productA.slug ||
      entry.data.productB_slug === productA.slug ||
      entry.data.productA_slug === productB.slug ||
      entry.data.productB_slug === productB.slug
    ))
    .slice(0, 3);
} catch {
  allComparisons = [];
  related = [];
}

const everFloSlug = 'philips-everflo-5-lpm';
const homeMedixSlug = 'home-medix-5-lpm';
const includesEverFlo = productA.slug === everFloSlug || productB.slug === everFloSlug;
const includesHomeMedix = productA.slug === homeMedixSlug || productB.slug === homeMedixSlug;
const showHomeMedixAlternative = includesEverFlo && !includesHomeMedix;
const everFloOpponent = productA.slug === everFloSlug ? productB : productA;

const homeMedixEntry = showHomeMedixAlternative
  ? await getEntry('products', homeMedixSlug)
  : undefined;
const homeMedixReview = showHomeMedixAlternative
  ? await getEntry('product-reviews', homeMedixSlug)
  : undefined;
const homeMedixImage = homeMedixEntry?.data.images?.[0] ?? null;
const homeMedixOpponentComparison = showHomeMedixAlternative
  ? allComparisons.find((entry) => {
      const slugs = [entry.data.productA_slug, entry.data.productB_slug];
      return slugs.includes(homeMedixSlug) && slugs.includes(everFloOpponent.slug);
    })
  : undefined;
const homeMedixVsEverFlo = showHomeMedixAlternative
  ? allComparisons.find((entry) => {
      const slugs = [entry.data.productA_slug, entry.data.productB_slug];
      return slugs.includes(homeMedixSlug) && slugs.includes(everFloSlug);
    })
  : undefined;
const isOxymedMiniMatchup = everFloOpponent.slug === 'oxymed-mini-5-lpm';

const winner = writeupFrontmatter?.winner;
const winnerLabel = winner === 'A'
  ? productA.product_name
  : winner === 'B'
  ? productB.product_name
  : winner === 'tie'
  ? 'Tie'
  : null;

// Both compared products share the same category (category-lock rule in CompareBuilder);
// prefer productA's category for the Top-5 link.
function topFivePillar(cat: string | undefined): { href: string; label: string } | null {
  if (!cat) return null;
  const c = cat.trim();
  if (c === '5 LPM') return { href: '/top-5/5-lpm-oxygen-concentrators/', label: 'Top 5 5 LPM concentrators in India (2026)' };
  if (c === '10 LPM') return { href: '/top-5/10-lpm-oxygen-concentrators/', label: 'Top 5 10 LPM concentrators in India (2026)' };
  if (/portable/i.test(c)) return { href: '/top-5/portable-oxygen-concentrators/', label: 'Top 5 portable concentrators in India (2026)' };
  if (c === 'CPAP') return { href: '/top-5/cpap-machines/', label: 'Top 5 CPAP machines in India (2026)' };
  if (c === 'BiPAP') return { href: '/top-5/bipap-machines/', label: 'Top 5 BiPAP machines in India (2026)' };
  return null;
}
const topFive = topFivePillar(productA.category);
---
<BaseLayout
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  preloadImage={imageA?.src}
>
  <article class="compare">
    <Breadcrumbs items={breadcrumbs} />

    <header class="compare__header">
      <h1>{productA.product_name} <span class="compare__vs">vs</span> {productB.product_name}</h1>
      <p class="meta-line">
        Head-to-head scored against the published spec rubric.
        {writeupFrontmatter?.lastReviewed && (
          <span>· Reviewed <time datetime={writeupFrontmatter.lastReviewed}>{writeupFrontmatter.lastReviewed}</time></span>
        )}
      </p>
    </header>

    {topFive && (
      <aside class="compare__topfive" aria-label="Category ranking">
        <span class="compare__topfive-kicker">HHZ ranking</span>
        <a href={topFive.href}>{topFive.label} →</a>
      </aside>
    )}

    {writeupFrontmatter?.verdict && (
      <aside class="compare__verdict-box">
        <p class="compare__verdict-kicker">
          {winnerLabel ? `VERDICT — ${winnerLabel}` : 'VERDICT'}
        </p>
        <p class="compare__verdict-body">{writeupFrontmatter.verdict}</p>
      </aside>
    )}

    <div class="comparison">
      <section
        class:list={['compare__card', winner === 'A' && 'compare__card--winner']}
        aria-labelledby="compare-a-heading"
      >
        {winner === 'A' && <p class="compare__winner-flag">EDITORIAL PICK</p>}
        <h2 id="compare-a-heading" class="compare__card-title">
          <a href={hrefA}>{productA.product_name}</a>
        </h2>
        {imageA && (
          <figure class="compare__image">
            <ProductImage src={imageA.src} alt={imageA.alt || productA.product_name} loading="lazy" />
          </figure>
        )}
        <dl class="compare__facts">
          {productA.brand && (
            <>
              <dt>Brand</dt>
              <dd>{productA.brand}</dd>
            </>
          )}
          {productA.category && (
            <>
              <dt>Category</dt>
              <dd class="mono-data">{productA.category}</dd>
            </>
          )}
        </dl>
        <PriceBadge
          product={productA}
          stock={productA.stock}
        />
        <PriceDisclaimer />
        {typeof productAScore === 'number' && (
          <p class="compare__score" aria-label="HHZ score">
            <span class="compare__score-label">HHZ SCORE</span>
            <span class="compare__score-value mono-data">
              {productAScore.toFixed(1)}<span class="compare__score-denom">/10</span>
            </span>
          </p>
        )}
      </section>

      <section
        class:list={['compare__card', winner === 'B' && 'compare__card--winner']}
        aria-labelledby="compare-b-heading"
      >
        {winner === 'B' && <p class="compare__winner-flag">EDITORIAL PICK</p>}
        <h2 id="compare-b-heading" class="compare__card-title">
          <a href={hrefB}>{productB.product_name}</a>
        </h2>
        {imageB && (
          <figure class="compare__image">
            <ProductImage src={imageB.src} alt={imageB.alt || productB.product_name} loading="lazy" />
          </figure>
        )}
        <dl class="compare__facts">
          {productB.brand && (
            <>
              <dt>Brand</dt>
              <dd>{productB.brand}</dd>
            </>
          )}
          {productB.category && (
            <>
              <dt>Category</dt>
              <dd class="mono-data">{productB.category}</dd>
            </>
          )}
        </dl>
        <PriceBadge
          product={productB}
          stock={productB.stock}
        />
        <PriceDisclaimer />
        {typeof productBScore === 'number' && (
          <p class="compare__score" aria-label="HHZ score">
            <span class="compare__score-label">HHZ SCORE</span>
            <span class="compare__score-value mono-data">
              {productBScore.toFixed(1)}<span class="compare__score-denom">/10</span>
            </span>
          </p>
        )}
      </section>
    </div>

    <section aria-labelledby="specs-compare-heading">
      <h2 id="specs-compare-heading">Specifications compared</h2>
      <ComparisonTable productA={productA} productB={productB} />
    </section>

    {showHomeMedixAlternative && homeMedixEntry && (
      <aside class="compare__third-option" aria-labelledby="home-medix-alternative-heading">
        <div class="compare__third-option-copy">
          <p class="compare__third-option-kicker">Third option worth comparing</p>
          <h2 id="home-medix-alternative-heading">
            Before deciding, compare the Home Medix HM-KV
          </h2>
          <p>
            This matchup covers {everFloOpponent.product_name} and Philips EverFlo, but the
            {' '}<a href="/oxygen-concentrators/home-medix-5-lpm/">Home Medix HM-KV 5 LPM</a>
            {' '}belongs on the same India shortlist. It is a current 5 LPM alternative with a
            13 kg chassis, published sound at or below 40 dB, 320 VA draw, live oxygen-purity
            readout, and a 3-year / 10,000-hour warranty.
          </p>
          {isOxymedMiniMatchup ? (
            <p>
              Against the Oxymed Mini, HM-KV is the specification-led alternative for buyers who
              prioritise lower published sound, lower power draw, lighter weight, and a live purity
              display. Oxymed can remain the better service-first choice where its authorised local
              network is stronger. Confirm the actual service route for the patient's pincode before
              choosing either machine.
            </p>
          ) : (
            <p>
              HM-KV is strongest where Home Medix can prove authorised local service and the buyer
              values low published noise, lighter handling, purity monitoring, and an India-based
              warranty route. It should not be chosen on specifications alone: confirm pincode-level
              service, major-spare availability, and warranty handling before payment.
            </p>
          )}

          <dl class="compare__third-option-facts">
            <div>
              <dt>Indicative price</dt>
              <dd>{formatPrice(resolvePrice(homeMedixEntry.data), 'current', 'raw')}</dd>
            </div>
            <div>
              <dt>Continuous flow</dt>
              <dd>0.5–5 L/min</dd>
            </div>
            <div>
              <dt>Noise / weight</dt>
              <dd>≤40 dB / 13 kg</dd>
            </div>
            <div>
              <dt>HHZ score</dt>
              <dd>{typeof homeMedixReview?.data.score === 'number' ? `${homeMedixReview.data.score.toFixed(1)}/10` : 'See review'}</dd>
            </div>
          </dl>

          <div class="compare__third-option-links">
            <a class="compare__third-option-primary" href="/oxygen-concentrators/home-medix-5-lpm/">
              Read the HM-KV review
            </a>
            {homeMedixOpponentComparison ? (
              <a href={`/compare/${homeMedixOpponentComparison.data.slug}/`}>
                Compare HM-KV with {everFloOpponent.product_name}
              </a>
            ) : homeMedixVsEverFlo ? (
              <a href={`/compare/${homeMedixVsEverFlo.data.slug}/`}>
                Compare HM-KV with Philips EverFlo
              </a>
            ) : null}
          </div>
        </div>

        {homeMedixImage && (
          <figure class="compare__third-option-image">
            <ProductImage
              src={homeMedixImage.src}
              alt={homeMedixImage.alt || homeMedixEntry.data.product_name}
              loading="lazy"
            />
          </figure>
        )}
      </aside>
    )}

    <section class="compare__analysis" aria-labelledby="analysis-heading">
      <h2 id="analysis-heading">Analysis</h2>
      <div class="content-width">
        <slot />
      </div>
    </section>

    {related.length > 0 && (
      <section class="compare__related" aria-labelledby="related-compare-heading">
        <h2 id="related-compare-heading">Related comparisons</h2>
        <ul class="compare__related-list">
          {related.map((entry) => (
            <li>
              <a href={`/compare/${entry.data.slug}/`}>{entry.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .compare__header {
    margin-bottom: var(--space-6);
  }
  .compare__vs {
    color: var(--color-accent);
    font-weight: 500;
    font-style: italic;
  }
  .compare__topfive {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block: var(--space-5);
    padding: var(--space-3) var(--space-4);
    border-left: 3px solid var(--color-accent);
    background: var(--color-data-bg);
  }
  .compare__topfive-kicker {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    font-weight: 600;
  }
  .compare__topfive a {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    border-bottom: 1px solid var(--color-accent);
  }
  .compare__topfive a:hover {
    color: var(--color-accent);
  }

  .compare__verdict-box {
    border: 1px solid var(--color-rule);
    padding: var(--space-5);
    background: var(--color-data-bg);
    margin: var(--space-6) 0 var(--space-8);
  }
  .compare__verdict-kicker {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    color: var(--color-accent);
    margin: 0 0 var(--space-2);
    font-weight: 700;
  }
  .compare__verdict-body {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: 1.45;
    color: var(--color-text);
  }
  .comparison {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
    margin-bottom: var(--space-8);
  }
  .compare__third-option {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(180px, 280px);
    gap: var(--space-6);
    margin: var(--space-8) 0;
    padding: var(--space-6);
    border: 1px solid var(--color-accent);
    background: var(--color-data-bg);
  }
  .compare__third-option-copy h2 {
    margin: 0 0 var(--space-3);
  }
  .compare__third-option-copy > p:not(.compare__third-option-kicker) {
    max-width: 72ch;
  }
  .compare__third-option-kicker {
    margin: 0 0 var(--space-2);
    color: var(--color-accent);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .compare__third-option-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    margin: var(--space-5) 0;
  }
  .compare__third-option-facts div {
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-rule);
  }
  .compare__third-option-facts dt {
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
  }
  .compare__third-option-facts dd {
    margin: var(--space-1) 0 0;
    font-family: var(--font-mono);
    font-weight: 700;
  }
  .compare__third-option-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .compare__third-option-primary {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    background: var(--color-accent);
    color: #fff;
    text-decoration: none;
  }
  .compare__third-option-primary:hover {
    color: #fff;
    filter: brightness(0.92);
  }
  .compare__third-option-image {
    align-self: center;
    margin: 0;
    aspect-ratio: 4 / 3;
    background: var(--color-bg);
    border: 1px solid var(--color-rule);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .compare__third-option-image img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    padding: var(--space-3);
  }
  @media (max-width: 720px) {
    .compare__third-option {
      grid-template-columns: 1fr;
    }
    .compare__third-option-image {
      max-width: 320px;
    }
  }
  @media (max-width: 720px) {
    .comparison { grid-template-columns: 1fr; }
  }
  .compare__card {
    padding: var(--space-5);
    border: 1px solid var(--color-rule);
    background: var(--color-bg);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    position: relative;
  }
  .compare__card--winner {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 1px var(--color-accent);
  }
  .compare__winner-flag {
    align-self: flex-start;
    margin: 0;
    padding: 2px var(--space-2);
    background: var(--color-accent);
    color: #fff;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .compare__score {
    margin: 0;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
    font-family: var(--font-mono);
    line-height: 1;
  }
  .compare__score-label {
    display: block;
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin-bottom: 4px;
  }
  .compare__score-value {
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--color-text);
  }
  .compare__score-denom {
    font-size: var(--text-base);
    color: var(--color-text-subtle);
    font-weight: 400;
  }
  .compare__card-title {
    font-size: var(--text-lg);
    margin: 0;
  }
  .compare__card-title a { color: inherit; text-decoration: none; }
  .compare__card-title a:hover { color: var(--color-accent); }
  .compare__image {
    margin: 0;
    aspect-ratio: 4 / 3;
    background: var(--color-surface);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .compare__image img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    padding: var(--space-3);
  }
  .compare__facts {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    font-size: var(--text-sm);
  }
  .compare__facts dt {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-subtle);
  }
  .compare__facts dd { margin: 0; }
  .compare__analysis {
    margin-top: var(--space-12);
  }
  .compare__related {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }
  .compare__related-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
</style>
