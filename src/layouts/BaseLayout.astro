---
import '../styles/global.css';
import hreflangData from '../data/hreflang.json';
import { LIVE_MARKETS, marketForPath } from '../data/markets';

export interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
  ogImage?: string;
  noindex?: boolean;
  /**
   * LCP-candidate image URL that the browser should start fetching before it
   * finishes parsing the rest of the HTML. Emitted as a <link rel="preload">
   * in <head>. Only pass this when the image is certain to be the largest
   * contentful paint element on the page (product hero, first compare card, etc.).
   */
  preloadImage?: string;
  /** <html lang>. Defaults to "en" (India pages); US pages pass "en-US". */
  lang?: string;
  frontmatter?: {
    title?: string;
    description?: string;
    canonicalURL?: string;
    ogImage?: string;
    noindex?: boolean;
  };
}

// MDX pages using `layout: BaseLayout.astro` pass frontmatter under Astro.props.frontmatter
// rather than as direct props. Fall back through frontmatter so both call styles work.
const props = Astro.props;
const fm = props.frontmatter ?? {};
const title = props.title ?? fm.title ?? 'HHZ Respiratory Review';
const description = props.description ?? fm.description;
const canonicalURL = props.canonicalURL ?? fm.canonicalURL;
const ogImage = props.ogImage ?? fm.ogImage;
const noindex = props.noindex ?? fm.noindex;
const preloadImage = props.preloadImage;
const lang = props.lang ?? 'en';

// If preloadImage points at /images/products/<file>.jpg|png, prefer the AVIF variant
// from /images/opt/ — most modern browsers support AVIF and it's typically 5–8×
// smaller than the JPG. Browsers without AVIF support ignore the preload and
// fetch the original via the <picture> fallback.
function preloadHref(src: string | undefined): string | undefined {
  if (!src) return undefined;
  const m = src.match(/^\/images\/products\/(.+)\.(jpe?g|png)$/i);
  if (!m) return src;
  return `/images/opt/${m[1]}.avif`;
}
function preloadType(src: string | undefined): string | undefined {
  if (!src) return undefined;
  if (/\/images\/products\/.+\.(jpe?g|png)$/i.test(src)) return 'image/avif';
  if (/\.avif$/i.test(src)) return 'image/avif';
  if (/\.webp$/i.test(src)) return 'image/webp';
  if (/\.(jpe?g)$/i.test(src)) return 'image/jpeg';
  if (/\.png$/i.test(src)) return 'image/png';
  return undefined;
}
const preloadHrefResolved = preloadHref(preloadImage);
const preloadTypeResolved = preloadType(preloadImage);

const SITE_NAME = 'HHZ Respiratory Review';
// Title separator: pipe is one of Google's documented site-name separators
// (along with `-`, `/`, `:`). Em-dash (—) is NOT recognized by Google's title
// parser, which causes Google to fall back to its inferred site name from
// external signals (Knowledge Graph, business listings, etc.) — which can be
// wrong. Pipe forces Google to recognize SITE_NAME as the site name.
// Keep the SERP title suffix compact. The full publication name remains in
// og:site_name, Organization schema and the visible masthead.
const fullTitle = title === SITE_NAME ? title : `${title} | HHZ`;
const resolvedCanonical = canonicalURL ?? new URL(Astro.url.pathname, Astro.site).toString();

const indiaNav = [
  { href: '/oxygen-concentrators/', label: 'Concentrators' },
  { href: '/cpap/', label: 'CPAP' },
  { href: '/bipap/', label: 'BiPAP' },
  { href: '/compare/', label: 'Compare' },
  { href: '/guides/', label: 'Guides' },
  { href: '/clinical/', label: 'Clinical' },
];

// Market sections only ship a hub and a guides tree, so each nav item maps to
// that market's closest existing page. Items with no equivalent are hidden;
// a non-India market never links into the India sections.
const marketNav: Record<string, Array<{ href: string; label: string }>> = {
  us: [
    { href: '/us/guides/oxygen-concentrator-buyers-guide/', label: 'Concentrators' },
    { href: '/us/guides/apap-vs-cpap-vs-bipap/', label: 'CPAP' },
    { href: '/us/guides/bipap-asv-medicare-coverage/', label: 'BiPAP' },
    { href: '/us/guides/', label: 'Guides' },
  ],
  uk: [
    { href: '/uk/guides/home-oxygen-concentrator-uk/', label: 'Concentrators' },
    { href: '/uk/guides/buying-cpap-privately-uk/', label: 'CPAP' },
    { href: '/uk/guides/', label: 'Guides' },
  ],
  sg: [
    { href: '/sg/guides/home-oxygen-concentrator-singapore/', label: 'Concentrators' },
    { href: '/sg/guides/cpap-machine-price-singapore/', label: 'CPAP' },
    { href: '/sg/guides/', label: 'Guides' },
  ],
  au: [
    { href: '/au/guides/home-oxygen-concentrator-australia/', label: 'Concentrators' },
    { href: '/au/guides/cpap-machine-price-australia/', label: 'CPAP' },
    { href: '/au/guides/', label: 'Guides' },
  ],
  ca: [
    { href: '/ca/guides/home-oxygen-concentrator-canada/', label: 'Concentrators' },
    { href: '/ca/guides/cpap-machine-price-canada/', label: 'CPAP' },
    { href: '/ca/guides/', label: 'Guides' },
  ],
  nz: [
    { href: '/nz/guides/oxygen-concentrator-price-nz/', label: 'Concentrators' },
    { href: '/nz/guides/cpap-machine-price-nz/', label: 'CPAP' },
    { href: '/nz/guides/', label: 'Guides' },
  ],
};

const navMarket = Astro.url.pathname.match(/^\/(us|uk|sg|au|ca|nz)(\/|$)/)?.[1];
const nav = (navMarket && marketNav[navMarket]) || indiaNav;

const footerNav = [
  { href: '/about/', label: 'About' },
  { href: '/methodology/', label: 'Methodology' },
  { href: '/editorial-policy/', label: 'Editorial policy' },
  { href: '/correction-policy/', label: 'Corrections' },
  { href: '/authors/hhz-editorial/', label: 'Authors' },
  { href: '/datasets/', label: 'Datasets' },
  { href: '/privacy-policy/', label: 'Privacy' },
  { href: '/terms/', label: 'Terms' },
  { href: '/contact/', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
const isUS = currentPath === '/us/' || currentPath.startsWith('/us/');
const intlMarket = marketForPath(currentPath);
const markets = [
  { href: '/in/', label: 'India', current: currentPath !== '/' && !isUS && !intlMarket },
  { href: '/us/', label: 'United States', current: isUS },
  ...LIVE_MARKETS.map((m) => ({ href: `/${m.code}/`, label: m.short, current: intlMarket?.code === m.code })),
];
// Longest matching nav href wins, so a market guide that is also the
// "Concentrators"/"CPAP" target does not light up "Guides" as well.
const activeNavHref = nav
  .map((i) => i.href)
  .filter((h) => currentPath === h || currentPath.startsWith(h))
  .sort((a, b) => b.length - a.length)[0];
const isCurrent = (href: string) => href === activeNavHref;

// hreflang: emit alternates only for pages that have a declared regional twin.
const hreflangPair = (hreflangData.pairs as Array<Record<string, string>>).find((pair) =>
  Object.values(pair).includes(currentPath)
);
const hreflangLinks = hreflangPair
  ? [
      ...Object.entries(hreflangPair).map(([hreflang, path]) => ({
        hreflang,
        href: new URL(path, Astro.site).toString(),
      })),
      // A pair may name its own x-default (the global homepage does); otherwise India is the default.
      ...(hreflangPair['x-default']
        ? []
        : [{ hreflang: 'x-default', href: new URL(hreflangPair['en-IN'] ?? Object.values(hreflangPair)[0], Astro.site).toString() }]),
    ]
  : [];
---
<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={resolvedCanonical} />
    {hreflangLinks.map((l) => <link rel="alternate" hreflang={l.hreflang} href={l.href} />)}
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {/* Open Graph */}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={resolvedCanonical} />
    {description && <meta property="og:description" content={description} />}
    {ogImage && <meta property="og:image" content={ogImage} />}

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    {description && <meta name="twitter:description" content={description} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* Search-engine site verification */}
    <meta name="msvalidate.01" content="6ECFCE02F5709B4149C6D239E2541ACA" />

    {preloadHrefResolved && (
      <link
        rel="preload"
        as="image"
        href={preloadHrefResolved}
        type={preloadTypeResolved}
        fetchpriority="high"
      />
    )}

    {/* Feeds */}
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} (RSS)`} href="/feed.xml" />
    <link rel="alternate" type="application/feed+json" title={`${SITE_NAME} (JSON)`} href="/feed.json" />

    {/* LLM-friendly corpus index */}
    <link rel="alternate" type="text/plain" title="LLM index" href="/llms.txt" />

    {/* Google Analytics 4 (gtag.js) */}
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-1H7QJH18QS"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-1H7QJH18QS');
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <header class="site-header">
      <div class="container">
        <a href="/" class="masthead" aria-label="HHZ Respiratory Review home">
          <strong>HHZ</strong> Respiratory Review
        </a>
        <nav class="site-nav" aria-label="Primary">
          {nav.map((item) => (
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
        <nav class="market-switch" aria-label="Market">
          <span class="market-switch__label">Market:</span>
          {markets.map((m, i) => (
            <>
              <a href={m.href} aria-current={m.current ? 'true' : undefined}>{m.label}</a>
              {i < markets.length - 1 && <span aria-hidden="true"> | </span>}
            </>
          ))}
        </nav>
      </div>
    </header>

    <main id="main" class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <nav aria-label="Footer">
          {footerNav.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>
        <p>
          Choose your market: {markets.map((m, i) => (
            <>{i > 0 && ' | '}<a href={m.href}>{m.label}</a></>
          ))}
        </p>
        <p>
          © {new Date().getFullYear()} {SITE_NAME}. Respiratory equipment directory for India, the US, UK, Singapore,
          Australia, Canada and New Zealand. Devices are scored against the same <a href="/methodology/">published rubric</a>.
        </p>
      </div>
    </footer>
  </body>
</html>
