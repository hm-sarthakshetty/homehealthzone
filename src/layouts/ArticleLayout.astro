---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SchemaArticle from '../components/SchemaArticle.astro';
import SchemaFAQ from '../components/SchemaFAQ.astro';
import SchemaMedicalWebPage from '../components/SchemaMedicalWebPage.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { marketByCode } from '../data/markets';

type ArticleSection = 'guides' | 'clinical';
type ArticleEntry =
  | CollectionEntry<'guides'>
  | CollectionEntry<'clinical'>
  | CollectionEntry<'us-guides'>
  | CollectionEntry<'intl-guides'>;

export interface Props {
  entry: ArticleEntry;
  section: ArticleSection;
  sectionLabel: string;
  title?: string;
  description?: string;
  canonicalURL?: string;
  headings?: Array<{ depth: number; slug: string; text: string }>;
  /** Market. 'US' switches language/date locale, breadcrumbs and related links to the US section. */
  market?: string;
}

const {
  entry,
  section,
  sectionLabel,
  title: titleProp,
  description: descriptionProp,
  canonicalURL,
  headings = [],
  market = 'IN',
} = Astro.props;
const isUS = market === 'US';
// Regional markets (uk, sg, au, ca, nz) pass their URL code.
const intl = marketByCode(market);
const locale = intl ? intl.lang : isUS ? 'en-US' : 'en-IN';

const frontmatter = entry.data;
const isClinical = section === 'clinical';
const basePath = `/${section}/`;

const breadcrumbs = intl
  ? [
      { href: '/', label: 'Home' },
      { href: `/${intl.code}/`, label: intl.label },
      { href: `/${intl.code}/guides/`, label: 'Guides' },
      { label: frontmatter.title },
    ]
  : isUS
  ? [
      { href: '/', label: 'Home' },
      { href: '/us/', label: 'United States' },
      { href: '/us/guides/', label: 'Guides' },
      { label: frontmatter.title },
    ]
  : [
      { href: '/', label: 'Home' },
      { href: basePath, label: sectionLabel },
      { label: frontmatter.title },
    ];

function formatDate(iso?: string): string | null {
  if (!iso) return null;
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return null;
  return d.toLocaleDateString(locale, {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

const formattedLastReviewed = formatDate(frontmatter.lastReviewed);
const formattedNextReview = formatDate(frontmatter.nextReview);
const formattedPublished = formatDate(frontmatter.datePublished);
const formattedModified = formatDate(frontmatter.dateModified);

const answer: string | undefined = frontmatter.answer;
const faqs = frontmatter.faqs ?? [];
const faqGroups = [...new Set(faqs.map((faq) => faq.topic ?? ''))].map((topic) => ({
  topic,
  items: faqs.filter((faq) => (faq.topic ?? '') === topic),
}));

// Include the visible summary and FAQs in reading time and Article word count.
const rawBody: string = (entry as any).body ?? '';
const readingText = [rawBody, answer ?? '', ...faqs.flatMap((faq) => [faq.q, faq.a])].join(' ');
const wordCount = readingText.trim()
  ? readingText
      .replace(/```[\s\S]*?```/g, '') // skip code blocks
      .replace(/[#>*_`[\]()~\-]/g, ' ') // strip common markdown punctuation
      .split(/\s+/)
      .filter(Boolean).length
  : 0;
const readingMinutes = wordCount > 0 ? Math.max(1, Math.round(wordCount / 220)) : 0;

// Build a semantic related-content graph across clinical and buyer-guide
// collections. Shared tags carry most weight; meaningful title/description
// tokens provide a fallback for older entries with sparse tags.
let related: ArticleEntry[] = [];
try {
  // US pages only cross-link other US pages; India pages keep the original graph.
  const entries: ArticleEntry[] = intl
    ? (await getCollection('intl-guides')).filter((e) => e.id.startsWith(`${intl.code}/`))
    : isUS
    ? await getCollection('us-guides')
    : [...(await getCollection('clinical')), ...(await getCollection('guides'))];
  const currentTags = new Set((frontmatter.tags ?? []).map((tag) => tag.toLowerCase()));
  const stopwords = new Set([
    'and', 'are', 'best', 'for', 'from', 'how', 'india', 'into', 'the', 'this',
    'what', 'when', 'where', 'which', 'with', 'your', 'guide', 'explained',
  ]);
  const tokens = (value: string) =>
    new Set(
      value
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, ' ')
        .split(/\s+/)
        .filter((token) => token.length > 2 && !stopwords.has(token))
    );
  const currentTokens = tokens(`${frontmatter.title} ${frontmatter.description}`);
  const ranked = entries
    .filter((candidate) => !(candidate.collection === entry.collection && candidate.id === entry.id))
    .map((candidate) => {
      const candidateTags = new Set((candidate.data.tags ?? []).map((tag) => tag.toLowerCase()));
      const tagOverlap = [...currentTags].filter((tag) => candidateTags.has(tag)).length;
      const candidateTokens = tokens(`${candidate.data.title} ${candidate.data.description}`);
      const tokenOverlap = [...currentTokens].filter((token) => candidateTokens.has(token)).length;
      const complementarySection = candidate.collection !== entry.collection ? 1 : 0;
      return { candidate, score: tagOverlap * 8 + Math.min(tokenOverlap, 6) + complementarySection };
    })
    .sort((a, b) => {
      if (b.score !== a.score) return b.score - a.score;
      return (b.candidate.data.lastReviewed ?? '').localeCompare(a.candidate.data.lastReviewed ?? '');
    });
  // Always provide a contextual onward path. Sparse-tag legacy articles used
  // to end with no related links, which left a group of otherwise useful
  // pages internally isolated.
  related = ranked.slice(0, 4).map(({ candidate }) => candidate);
} catch {
  related = [];
}

const title = titleProp ?? frontmatter.title;
const description = descriptionProp ?? frontmatter.description;

const image = frontmatter.image ? new URL(frontmatter.image, Astro.site).toString() : undefined;
const toc = frontmatter.showToc ? headings.filter((h) => h.depth === 2) : [];
---
<BaseLayout title={title} description={description} canonicalURL={canonicalURL} lang={locale}
  ogType="article" ogImage={image} ogImageAlt={frontmatter.imageAlt}
  ogImageWidth={frontmatter.imageWidth} ogImageHeight={frontmatter.imageHeight}
  publishedTime={frontmatter.datePublished} modifiedTime={frontmatter.dateModified ?? frontmatter.lastReviewed}>
  <article class="article">
    <Breadcrumbs items={breadcrumbs} />

    <header class="article__header">
      <h1>{frontmatter.title}</h1>
      <p class="meta-line">
        {frontmatter.datePublished && formattedPublished && (
          <span>
            <time datetime={frontmatter.datePublished}>Published {formattedPublished}</time>
          </span>
        )}
        {frontmatter.lastReviewed && formattedLastReviewed && (
          <span>
            <time datetime={frontmatter.lastReviewed}>{frontmatter.reviewedBy ? 'Clinical review' : 'Previous review'} {formattedLastReviewed}</time>
          </span>
        )}
        {frontmatter.dateModified && formattedModified && (
          <span><time datetime={frontmatter.dateModified}>Editorial update {formattedModified}</time></span>
        )}
        {readingMinutes > 0 && <span>{readingMinutes} min read</span>}
        <span>
          By {frontmatter.author === 'HHZ Editorial' || !frontmatter.author ? (
            <a href="/authors/hhz-editorial/">HHZ Editorial</a>
          ) : frontmatter.author}
        </span>
        {frontmatter.nextReview && formattedNextReview && (
          <span>
            Next review <time datetime={frontmatter.nextReview}>{formattedNextReview}</time>
          </span>
        )}
      </p>
    </header>

    {answer && (
      <div class="article__answer content-width" role="note">
        <p>{answer}</p>
      </div>
    )}

    {toc.length > 0 && (
      <nav class="article__toc content-width" aria-label="On this page">
        <h2>On this page</h2>
        <ul>
          {toc.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
          {faqs.length > 0 && <li><a href="#article-faq-heading">Buying questions and FAQs</a></li>}
        </ul>
      </nav>
    )}

    <div class="article__body content-width">
      <slot />
    </div>

    {faqs.length > 0 && (
      <section class="article__faq content-width" aria-labelledby="article-faq-heading">
        <h2 id="article-faq-heading">Frequently asked questions</h2>
        {faqGroups.map((group) => (
          <div>
            {group.topic && <h3>{group.topic}</h3>}
            <dl>
              {group.items.map((f) => (
                <>
                  <dt>{f.q}</dt>
                  <dd>{f.a}{f.source && <p class="faq-source"><a href={f.source}>{f.sourceLabel ?? 'Source document'}</a></p>}</dd>
                </>
              ))}
            </dl>
          </div>
        ))}
      </section>
    )}

    {related.length > 0 && (
      <section class="article__related" aria-labelledby="related-articles-heading">
        <h2 id="related-articles-heading">Related respiratory reading</h2>
        <div class="grid">
          {related.map((rel) => (
            <ArticleCard entry={rel} />
          ))}
        </div>
      </section>
    )}
  </article>

  <SchemaArticle
    title={frontmatter.title}
    description={frontmatter.description}
    lastReviewed={frontmatter.lastReviewed}
    datePublished={frontmatter.datePublished}
    dateModified={frontmatter.dateModified}
    author={frontmatter.author ?? 'HHZ Editorial'}
    authorUrl={frontmatter.author === 'HHZ Editorial' || !frontmatter.author ? '/authors/hhz-editorial/' : undefined}
    wordCount={wordCount || undefined}
    inLanguage={locale}
    image={image}
    about={frontmatter.about}
    citations={frontmatter.citations}
  />
  {faqs.length > 0 && <SchemaFAQ faqs={faqs} />}
  {isClinical && (
    <SchemaMedicalWebPage
      title={frontmatter.title}
      description={frontmatter.description}
      lastReviewed={frontmatter.lastReviewed}
      datePublished={frontmatter.datePublished}
      dateModified={frontmatter.dateModified}
      reviewedBy={frontmatter.reviewedBy}
      credentials={frontmatter.credentials}
    />
  )}
</BaseLayout>

<style>
  .article__header {
    margin-bottom: var(--space-8);
  }
  .article__body {
    /* content-width class from global.css narrows the column */
  }
  .article__toc { margin: 0 0 var(--space-8); padding: var(--space-4) var(--space-5); border: 1px solid var(--color-border); }
  .article__toc h2 { margin: 0 0 var(--space-3); font-size: var(--text-base); }
  .article__toc ul { margin: 0; padding-left: var(--space-5); }
  .article__toc li { margin-block: var(--space-2); }
  .article__body :global(h2[id]) { scroll-margin-top: 14rem; }
  .article__body :global(.comparison-table-scroll table) { border-collapse: collapse; width: 100%; margin: 0; }
  .article__body :global(.comparison-table-scroll th),
  .article__body :global(.comparison-table-scroll td) { min-width: 12rem; padding: var(--space-3); border: 1px solid var(--color-border); text-align: left; vertical-align: top; }
  .article__body :global(.comparison-table-scroll th) { background: var(--color-data-bg); }
  .article__answer {
    border-left: 3px solid var(--color-accent);
    background: var(--color-data-bg);
    padding: var(--space-4) var(--space-5);
    margin: 0 0 var(--space-6);
  }
  .article__answer p {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--color-text);
  }
  .article__faq {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }
  .article__faq h2 { scroll-margin-top: 14rem; }
  .article__faq .faq-source { margin: var(--space-2) 0 0; font-size: var(--text-sm); }
  .article__faq dt {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--text-base);
    color: var(--color-text);
    margin-top: var(--space-5);
  }
  .article__faq dd {
    margin: var(--space-2) 0 0;
    font-family: var(--font-serif);
    line-height: 1.55;
    color: var(--color-text-muted);
  }
  .article__related {
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }
</style>
