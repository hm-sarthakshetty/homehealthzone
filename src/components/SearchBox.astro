---
import type { CollectionEntry } from 'astro:content';
import { productSearchKeywords } from '../lib/search-core.mjs';
import { formatPrice, resolvePrice } from '../lib/price';

type ProductEntry = CollectionEntry<'products'> | CollectionEntry<'cpap-bipap'>;
export interface Props {
  entries?: ProductEntry[];
  src?: string;
  market?: string;
  resultType?: 'all' | 'device' | 'guide' | 'clinical' | 'partner' | 'manufacturer';
  id?: string;
  label?: string;
  placeholder?: string;
  minChars?: number;
  maxResults?: number;
  target?: 'navigate' | 'select';
  /** Complete results, URL query and market/type controls on /search/. */
  fullResults?: boolean;
}
const { entries = [], src, market = 'all', resultType = 'all', id = 'search-box',
  label = 'Search HHZ', placeholder = 'Search devices, guides and clinical articles…',
  minChars = 2, maxResults = 8, target = 'navigate', fullResults = false } = Astro.props;
const index = entries.map((entry) => ({
  slug: entry.data.slug, name: entry.data.product_name, brand: entry.data.brand,
  category: entry.data.category, market: 'in', type: 'd',
  keywords: productSearchKeywords(entry.data), image: entry.data.images?.[0]?.src ?? null,
  href: `/${entry.collection === 'cpap-bipap' ? entry.data.device_type : 'oxygen-concentrators'}/${entry.data.slug}/`,
  discontinued: entry.data.stock.toLowerCase().includes('discontinued'),
  price: entry.data.stock.toLowerCase().includes('discontinued') ? '' : formatPrice(resolvePrice(entry.data, 'IN')),
}));
---
<div class:list={['searchbox', { 'searchbox--full': fullResults }]} data-search-id={id}
  data-min-chars={minChars} data-max-results={maxResults} data-target={target}
  data-src={src} data-market={market} data-result-type={resultType} data-full-results={String(fullResults)}>
  <label class="searchbox__label" for={`${id}-input`}>{label}</label>
  <input type="search" class="searchbox__input mono-data" id={`${id}-input`}
    placeholder={placeholder} autocomplete="off" spellcheck="false" role="combobox"
    aria-expanded="false" aria-controls={`${id}-list`} aria-autocomplete="list"
    aria-describedby={`${id}-hint ${id}-status`} />
  <p class="searchbox__hint" id={`${id}-hint`}>
    {fullResults ? 'Filter by country and content type. Use arrow keys to select a result, then Enter to open it.' : `Enter at least ${minChars} characters. Use arrow keys to select a result, then Enter.`}
  </p>
  {fullResults && <div class="searchbox__filters">
    <label>Country <select class="searchbox__market">
      <option value="all">All countries</option><option value="in">India</option><option value="us">United States</option>
      <option value="uk">United Kingdom</option><option value="sg">Singapore</option><option value="au">Australia</option>
      <option value="ca">Canada</option><option value="nz">New Zealand</option>
    </select></label>
    <label>Content type <select class="searchbox__type">
      <option value="all">All content</option><option value="device">Device reviews · India</option>
      <option value="guide">Buying guides</option><option value="clinical">Clinical articles · India</option>
      <option value="partner">Service partners · India</option><option value="manufacturer">Manufacturers · India</option>
    </select></label>
  </div>}
  <p class="searchbox__status" id={`${id}-status`} role="status" aria-live="polite" aria-atomic="true"></p>
  <button class="searchbox__retry" type="button" hidden>Retry search</button>
  <ul class="searchbox__list" id={`${id}-list`} role="listbox" aria-label={`${label} results`} hidden></ul>
  {!fullResults && target === 'navigate' && <a class="searchbox__all" href="/search/">View all search results</a>}
  {!src && <script type="application/json" class="searchbox__data" set:html={JSON.stringify(index).replace(/</g, '\u003c')} />}
  {!fullResults && <noscript><p>Search needs JavaScript. Browse <a href="/search/">all devices and articles</a>.</p></noscript>}
</div>
<script>
  import { initializeSearchBox } from '../lib/search-client.mjs';
  const initialize = () => document.querySelectorAll('.searchbox').forEach(initializeSearchBox);
  initialize();
  document.addEventListener('astro:page-load', initialize);
</script>

<style is:global>
  .searchbox {
    position: relative;
    font-family: var(--font-sans);
  }

  .searchbox__input {
    width: 100%;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-rule);
    background: var(--color-bg);
    font-family: var(--font-mono);
    font-size: var(--text-base);
    letter-spacing: -0.01em;
    border-radius: 0;
    outline: none;
    transition: border-color 0.12s ease;
  }
  .searchbox__input:focus {
    border-color: var(--color-accent);
    box-shadow: inset 0 0 0 1px var(--color-accent);
  }

  .searchbox__list {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    max-height: 420px;
    overflow-y: auto;
    background: var(--color-bg);
    border: 1px solid var(--color-rule);
    margin: 0;
    padding: 0;
    list-style: none;
    z-index: 50;
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.04);
  }
  .searchbox__list[hidden] { display: none; }

  .searchbox__list li { margin: 0; }
  .searchbox__list li + li { border-top: 1px solid var(--color-border); }

  .searchbox__result {
    display: grid;
    grid-template-columns: 20px 1fr;
    gap: var(--space-2);
    align-items: center;
    width: 100%;
    padding: var(--space-1) var(--space-3);
    text-align: left;
    background: transparent;
    border: 0;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
    font-family: inherit;
    min-height: 44px;
  }

  .searchbox__list li.searchbox__item--active .searchbox__result,
  .searchbox__result:hover,
  .searchbox__result:focus-visible {
    background: var(--color-surface);
    outline: none;
  }

  .searchbox__result img,
  .searchbox__noimg {
    width: 20px;
    height: 20px;
    object-fit: contain;
    background: var(--color-surface);
    display: block;
  }

  .searchbox__result-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .searchbox__result-name {
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--color-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .searchbox__flag {
    width: 20px;
    font-size: 16px;
    line-height: 20px;
    text-align: center;
  }


  .searchbox__result-meta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .searchbox__label { display: block; font-weight: 600; margin-bottom: var(--space-2); font-size: var(--text-sm); }
  .searchbox__hint, .searchbox__status { font-size: var(--text-xs); color: var(--color-text-muted); margin: var(--space-2) 0; }
  .searchbox__status { position: static; width: auto; height: auto; overflow: visible; clip: auto; white-space: normal; }
  .searchbox__all { display: inline-block; margin-top: var(--space-2); font-size: var(--text-sm); }
  .searchbox__retry { border: 1px solid var(--color-rule); background: var(--color-bg); padding: var(--space-2) var(--space-3); font: inherit; cursor: pointer; }
  .searchbox__retry[hidden] { display: none; }
  .searchbox__filters { display: flex; flex-wrap: wrap; gap: var(--space-4); margin-top: var(--space-4); }
  .searchbox__filters label { display: flex; flex-direction: column; gap: var(--space-1); font-size: var(--text-sm); }
  .searchbox__filters select { color: var(--color-text); background: var(--color-bg); border: 1px solid var(--color-rule); padding: var(--space-2); font: inherit; }
  .searchbox--full .searchbox__list { position: static; max-height: none; box-shadow: none; }
  .searchbox--full .searchbox__result { padding: var(--space-3); }
  .searchbox--full .searchbox__result-name { white-space: normal; }
</style>
