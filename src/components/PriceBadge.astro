---
import { formatPrice, resolvePrice, type Country, type PricedProduct } from '../lib/price';

export interface Props {
  /** Preferred: pass the product data and the market to render. */
  product?: PricedProduct;
  country?: Country;
  /** Legacy props (India text prices). */
  current?: string | null;
  mrp?: string | null;
  symbol?: string;
  stock?: string | null;
}

const { product, country = 'IN', current, mrp, symbol = '₹', stock } = Astro.props;

const resolved = resolvePrice(
  product ?? { price_current: current, price_mrp: mrp, price_symbol: symbol },
  country
);
const isDiscontinued = (stock ?? '').toLowerCase().includes('discontinued');
// Trailing .00 stripped for legacy INR text — whole-rupee convention.
const currentText = formatPrice(resolved, 'current', 'badge');
const mrpText = formatPrice(resolved, 'mrp', 'badge');
---
{isDiscontinued ? (
  <p class="price-badge">
    <span class="price-badge__discontinued" aria-label="Discontinued — no longer sold">Discontinued</span>
  </p>
) : currentText ? (
  <p class="price-badge">
    <span class="price-badge__current">{currentText}</span>
    {mrpText && <span class="price-badge__mrp">{mrpText}</span>}
  </p>
) : (
  <p class="price-badge">
    <span class="price-badge__current" aria-label="Price on request">Price on request</span>
  </p>
)}
{currentText && resolved.basis && (
  <small class="price-badge__basis">
    {resolved.basis === 'manufacturer-published' ? 'Manufacturer-published price' : 'Dealer quotation'}
    {resolved.tax_note && <> · {resolved.tax_note}</>}
    {resolved.checked_at && <> · checked <time datetime={resolved.checked_at}>{resolved.checked_at}</time></>}
  </small>
)}

<style>
  .price-badge__basis { display: block; font-size: var(--text-xs); color: var(--color-text-muted); }
  .price-badge__discontinued {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-error, #b00020);
  }
</style>
