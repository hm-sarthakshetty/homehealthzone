---
export interface Props {
  title: string;
  description: string;
  datePublished?: string;
  dateModified?: string;
  lastReviewed?: string;
  author?: string;
  authorUrl?: string;
  url?: string;
  wordCount?: number;
  inLanguage?: string;
  image?: string;
  about?: Array<{ name: string; url: string }>;
  citations?: string[];
}

const {
  title,
  description,
  datePublished,
  dateModified,
  lastReviewed,
  author,
  authorUrl,
  url,
  wordCount,
  inLanguage = 'en-IN',
  image,
  about = [],
  citations = [],
} = Astro.props;

const siteOrigin = Astro.site ? Astro.site.toString().replace(/\/$/, '') : '';
const canonicalUrl = url ?? new URL(Astro.url.pathname, Astro.site ?? 'https://example.com').toString();

const ld: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${canonicalUrl}#article`,
  url: canonicalUrl,
  headline: title,
  description,
  inLanguage,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
  publisher: {
    '@type': 'Organization',
    name: 'HHZ Respiratory Review',
    url: siteOrigin || undefined,
    logo: siteOrigin
      ? {
          '@type': 'ImageObject',
          url: `${siteOrigin}/favicon.svg`,
        }
      : undefined,
    publishingPrinciples: siteOrigin ? `${siteOrigin}/editorial-policy/` : undefined,
    ethicsPolicy: siteOrigin ? `${siteOrigin}/editorial-policy/` : undefined,
    correctionsPolicy: siteOrigin ? `${siteOrigin}/correction-policy/` : undefined,
  },
  // Speakable hints for voice assistants: first paragraph + H1 on article pages.
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['h1', '.article__body > p:first-of-type'],
  },
};

if (image) ld.image = [image];
if (about.length) ld.about = about.map((item) => ({ '@type': 'Product', '@id': `${new URL(item.url, Astro.site).toString()}#product`, name: item.name }));
if (citations.length) ld.citation = citations;

if (datePublished) ld.datePublished = datePublished;
if (dateModified ?? lastReviewed) ld.dateModified = dateModified ?? lastReviewed;

if (author) {
  ld.author = {
    '@type': author === 'HHZ Editorial' ? 'Organization' : 'Person',
    name: author,
    url: authorUrl ? new URL(authorUrl, Astro.site ?? 'https://example.com').toString() : undefined,
  };
}

if (typeof wordCount === 'number' && wordCount > 0) {
  ld.wordCount = wordCount;
}
---
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
