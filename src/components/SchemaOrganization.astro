---
const siteOrigin = Astro.site ? Astro.site.toString().replace(/\/$/, '') : '';

const ld = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'HHZ Respiratory Review',
  url: siteOrigin || undefined,
  logo: siteOrigin ? `${siteOrigin}/favicon.svg` : undefined,
  alternateName: 'HHZ Respiratory Equipment Directory',
  description: 'Respiratory equipment guides for India, the United States, the United Kingdom, Singapore, Australia, Canada and New Zealand, with a product directory and device comparisons for India.',
  areaServed: [
    { '@type': 'Country', name: 'India' },
    { '@type': 'Country', name: 'United States' },
    { '@type': 'Country', name: 'United Kingdom' },
    { '@type': 'Country', name: 'Singapore' },
    { '@type': 'Country', name: 'Australia' },
    { '@type': 'Country', name: 'Canada' },
    { '@type': 'Country', name: 'New Zealand' },
  ],
  knowsAbout: [
    'Oxygen concentrators',
    'CPAP therapy',
    'BiPAP therapy',
    'Non-invasive ventilation',
    'Home respiratory equipment in India',
    'Home respiratory equipment in the United States',
    'Home respiratory equipment in the UK, Singapore, Australia, Canada and New Zealand',
  ],
  publishingPrinciples: siteOrigin ? `${siteOrigin}/editorial-policy/` : undefined,
  ethicsPolicy: siteOrigin ? `${siteOrigin}/editorial-policy/` : undefined,
  correctionsPolicy: siteOrigin ? `${siteOrigin}/correction-policy/` : undefined,
  contactPoint: siteOrigin
    ? {
        '@type': 'ContactPoint',
        contactType: 'editorial enquiries and corrections',
        url: `${siteOrigin}/contact/`,
      }
    : undefined,
};
---
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
