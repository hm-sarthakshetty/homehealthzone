---
import type { CollectionEntry } from 'astro:content';
import { marketByCode } from '../data/markets';

type ArticleEntry =
  | CollectionEntry<'guides'>
  | CollectionEntry<'clinical'>
  | CollectionEntry<'us-guides'>
  | CollectionEntry<'intl-guides'>;

export interface Props {
  entry: ArticleEntry;
  href?: string;
}

const { entry, href: hrefOverride } = Astro.props;
const data = entry.data;

const basePath =
  entry.collection === 'clinical'
    ? '/clinical'
    : entry.collection === 'us-guides'
      ? '/us/guides'
      : '/guides';
const intlId = entry.collection === 'intl-guides' ? entry.id.replace(/\.(md|mdx)$/, '').split('/') : null;
const intlMarket = intlId ? marketByCode(intlId[0]) : undefined;
const fallbackHref = intlId
  ? `/${intlId[0]}/guides/${intlId.slice(1).join('/')}/`
  : `${basePath}/${entry.id.replace(/\.(md|mdx)$/, '')}/`;
const href = hrefOverride ?? fallbackHref;

const formattedDate = data.lastReviewed
  ? new Date(data.lastReviewed).toLocaleDateString(intlMarket ? intlMarket.lang : entry.collection === 'us-guides' ? 'en-US' : 'en-IN', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;
---
<a class="card" href={href}>
  <h3>{data.title}</h3>
  {data.description && <p>{data.description}</p>}
  {data.lastReviewed && formattedDate && (
    <p class="meta-line">
      <time datetime={data.lastReviewed}>Reviewed {formattedDate}</time>
    </p>
  )}
</a>
