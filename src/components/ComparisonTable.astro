---
import type { CollectionEntry } from 'astro:content';
import { formatPrice, resolvePrice } from '../lib/price';
import { buildComparisonSpecRows } from '../lib/comparison-specs.mjs';

type ProductEntry = CollectionEntry<'products'> | CollectionEntry<'cpap-bipap'>;

export interface Props {
  productA: ProductEntry['data'];
  productB: ProductEntry['data'];
}

const { productA, productB } = Astro.props;

interface Row {
  key: string;
  a: string;
  b: string;
  section?: string;
}

const sanitize = (v: string | null | undefined): string => {
  if (v === null || v === undefined) return '';
  const s = String(v).trim();
  return s;
};

const priceA = resolvePrice(productA);
const priceB = resolvePrice(productB);
const priceBasisLabel = (basis: string | undefined) => basis === 'manufacturer-published'
  ? 'Manufacturer-published price'
  : basis === 'dealer-quotation'
    ? 'Dealer quotation'
    : basis === 'editorial-estimate' ? 'HHZ budget estimate; not verified seller offers' : '';

const rows: Row[] = [];

// Basic fields
const basicPairs: Array<[string, string, string]> = [
  ['Brand', sanitize(productA.brand), sanitize(productB.brand)],
  ['Category', sanitize(productA.category), sanitize(productB.category)],
  [
    'Price',
    priceA.checked_at ? formatPrice(priceA, 'current', 'raw') ?? 'Dated quote required' : 'Dated quote required',
    priceB.checked_at ? formatPrice(priceB, 'current', 'raw') ?? 'Dated quote required' : 'Dated quote required',
  ],
  // Legacy behaviour: MRP cell carries no currency symbol.
  ['MRP', priceA.checked_at ? formatPrice(priceA, 'mrp', 'bare') ?? '' : '', priceB.checked_at ? formatPrice(priceB, 'mrp', 'bare') ?? '' : ''],
  ['Price basis / tax / checked', [priceBasisLabel(priceA.basis), priceA.tax_note, priceA.checked_at].filter(Boolean).join(' · '), [priceBasisLabel(priceB.basis), priceB.tax_note, priceB.checked_at].filter(Boolean).join(' · ')],
  ['Stock', sanitize(productA.stock), sanitize(productB.stock)],
];

for (const [key, a, b] of basicPairs) {
  if (a || b) rows.push({ key, a, b, section: 'Overview' });
}

rows.push(...buildComparisonSpecRows(productA, productB));

// Group rows by section for rendering.
const sections = new Map<string, Row[]>();
for (const row of rows) {
  const sec = row.section || 'Specifications';
  if (!sections.has(sec)) sections.set(sec, []);
  sections.get(sec)!.push(row);
}

const differs = (a: string, b: string) => {
  if (!a || !b) return false;
  return a.trim().toLowerCase() !== b.trim().toLowerCase();
};
---
<p class="comparison-table__note">Equivalent fields are shown together. “Not documented” means the reviewed product record does not establish that detail; it does not mean the feature is absent. Electrical ratings retain their published W or VA units.</p>
<table class="spec-table comparison-table">
  <caption>Side-by-side comparison</caption>
  <thead>
    <tr>
      <th scope="col">Specification</th>
      <th scope="col">{productA.product_name}</th>
      <th scope="col">{productB.product_name}</th>
    </tr>
  </thead>
  <tbody>
    {Array.from(sections.entries()).map(([section, sectionRows]) => (
      <>
        <tr class="row-section">
          <th scope="rowgroup" colspan="3">{section}</th>
        </tr>
        {sectionRows.map((row) => (
          <tr class={differs(row.a, row.b) ? 'row-differ' : undefined}>
            <th scope="row">{row.key}</th>
            <td>{row.a || 'Not documented'}</td>
            <td>{row.b || 'Not documented'}</td>
          </tr>
        ))}
      </>
    ))}
  </tbody>
</table>

<style>
  .comparison-table__note { font-size: var(--text-sm); color: var(--color-text-muted); }
  .comparison-table thead th {
    font-family: var(--font-sans);
    font-weight: 600;
    color: var(--color-text);
    border-bottom: 2px solid var(--color-border-strong);
  }
  .comparison-table .row-section th {
    background: #f8f7f4;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    padding-top: var(--space-4);
    padding-bottom: var(--space-3);
  }
  .comparison-table .row-differ td {
    background: #fff8f2;
  }
</style>
