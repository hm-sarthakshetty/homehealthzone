---
/**
 * Inline price for MDX prose: <Price slug="devilbiss-5-lpm" country="US" />.
 * Reads the product's prices map so prose never hard-codes a number that the
 * data (or a price-update job) can change. Renders a fallback when the market
 * has no verified price.
 */
import { getEntry } from 'astro:content';
import { formatPrice, resolvePrice, type Country } from '../lib/price';

export interface Props {
  slug: string;
  country?: Country;
  collection?: 'products' | 'cpap-bipap' | 'us-products';
  fallback?: string;
}

const { slug, country = 'IN', collection, fallback = 'price not verified' } = Astro.props;
const entry = collection
  ? await getEntry(collection, slug)
  : ((await getEntry('products', slug)) ??
    (await getEntry('cpap-bipap', slug)) ??
    (await getEntry('us-products', slug)));
if (!entry) throw new Error(`<Price>: unknown product slug "${slug}"`);
const text = formatPrice(resolvePrice(entry.data, country), 'current', 'badge') ?? fallback;
---
<span class="price-inline">{text}</span>
